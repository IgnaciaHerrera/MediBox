NODE_ENV=development
PORT=3000

DB_USER=medibox
DB_PASSWORD=change-me
DB_NAME=medibox
# Dueño de la base: solo lo usan las migraciones (servicio `migraciones`).
DATABASE_URL=postgresql://medibox:change-me@db:5432/medibox
# Contraseña del rol medibox_app, con el que se conecta la app (mínimo
# privilegio: sin DDL ni borrado de pacientes, citas o auditoría). Al menos
# 16 caracteres aleatorios, distinta de DB_PASSWORD:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_DB_PASSWORD=

# Secreto de firma de la cookie de sesión: al menos 32 caracteres aleatorios.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Llaves de cifrado de datos de paciente: 32 bytes aleatorios en base64,
# una distinta por variable. Generar cada una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PACIENTE_IDENTIDAD_KEY=
PACIENTE_CONTACTO_KEY=
PACIENTE_CLINICO_KEY=
PACIENTE_RUT_HMAC_KEY=
# Seudónimo de los pacientes en los archivos exportados (HMAC). Quien tenga
# esta llave y la base puede volver a identificar un seudónimo: guárdala
# separada de los archivos exportados y de los respaldos.
PACIENTE_SEUDONIMO_KEY=
# HMAC de los correos de los inicios de sesión fallidos en la auditoría:
# cuenta los intentos sobre una cuenta sin guardar el correo en claro.
AUDITORIA_HMAC_KEY=

# Canal de envío de códigos y recordatorios al contacto del paciente.
# Fuera de producción, por omisión se simula (registro/buzon-simulado.txt).
# En producción solo funciona con el correo del propio hospital:
# CANAL_ENVIO=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_REMITENTE=

# Solo si hay un proxy inverso con TLS delante de la app: qué proxy es de
# confianza para leer la IP del cliente (X-Forwarded-For), p. ej. "loopback"
# o la IP del proxy. Sin él, la auditoría registra la IP del proxy.
# TRUST_PROXY=

# Solo para migrar una base cifrada con la versión anterior (pgcrypto).
# Después de ejecutar `npm run cifrado:migrar` se puede eliminar.
PACIENTE_ENCRYPTION_KEY=
