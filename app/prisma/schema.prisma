generator client {
  provider        = "prisma-client-js"
  // `omit` permite que las consultas de citas no traigan el motivo cifrado
  // salvo cuando se pide explícitamente (src/lib/prisma.js).
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rolId        Int      @map("rol_id")
  createdAt    DateTime @default(now()) @map("created_at")

  rol            Rol            @relation(fields: [rolId], references: [id])
  citasEditadas  Cita[]         @relation("CitaUpdatedBy")
  auditLogs      AuditLog[]
  notificaciones Notificacion[]
  medico         Medico?
  cambiosHechos  HistorialCambio[]
  verificaciones VerificacionIdentidad[]

  @@map("usuarios")
}

model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  descripcion String?
  usuarios    Usuario[]
  permisos    RolPermiso[]

  @@map("roles")
}

model Permiso {
  id    Int          @id @default(autoincrement())
  clave String       @unique
  roles RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     Int @map("rol_id")
  permisoId Int @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
  @@map("rol_permisos")
}

model Especialidad {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique
  medicos Medico[]

  @@map("especialidades")
}

model Medico {
  id             Int    @id @default(autoincrement())
  nombre         String
  especialidadId Int    @map("especialidad_id")
  usuarioId      Int?   @unique @map("usuario_id")

  especialidad Especialidad @relation(fields: [especialidadId], references: [id])
  usuario      Usuario?     @relation(fields: [usuarioId], references: [id])
  citas        Cita[]

  @@map("medicos")
}

model Pasillo {
  id     Int    @id @default(autoincrement())
  nombre String @unique
  boxes  Box[]

  @@map("pasillos")
}

model Box {
  id        Int    @id @default(autoincrement())
  nombre    String
  pasilloId Int    @map("pasillo_id")

  pasillo      Pasillo       @relation(fields: [pasilloId], references: [id])
  instrumentos Instrumento[]
  citas        Cita[]

  @@unique([pasilloId, nombre])
  @@map("boxes")
}

model Instrumento {
  id     Int    @id @default(autoincrement())
  nombre String
  boxId  Int    @map("box_id")

  box Box @relation(fields: [boxId], references: [id])

  @@map("instrumentos")
}

// Los datos personales se cifran en la aplicación con AES-256-GCM
// (src/lib/cifrado.js); la base de datos solo ve blobs cifrados.
model Paciente {
  id                     Int      @id @default(autoincrement())
  nombreCifrado          Bytes    @map("nombre_cifrado")
  rutCifrado             Bytes    @map("rut_cifrado")
  // HMAC-SHA256 del RUT normalizado: búsqueda exacta y unicidad sin descifrar.
  rutIndice              Bytes    @unique @map("rut_indice")
  // AAAA-MM-DD cifrada con la llave de identidad: es un cuasi identificador
  // y la que revela si el paciente es menor de edad.
  fechaNacimientoCifrada Bytes    @map("fecha_nacimiento_cifrada")
  // Opcional: solo sirve para avisar al paciente de cambios en sus citas.
  contactoCifrado        Bytes?   @map("contacto_cifrado")
  createdAt              DateTime @default(now()) @map("created_at")

  citas          Cita[]
  cambios        HistorialCambio[]
  verificaciones VerificacionIdentidad[]

  @@map("pacientes")
}

// Rectificación: por cada campo que cambió, su valor anterior cifrado con la
// llave de su categoría ('historial.<campo>'). El valor nuevo ya está en el
// paciente.
model HistorialCambio {
  id                   Int      @id @default(autoincrement())
  pacienteId           Int      @map("paciente_id")
  campo                String // 'nombre' | 'rut' | 'fechaNacimiento' | 'contacto'
  valorAnteriorCifrado Bytes?   @map("valor_anterior_cifrado")
  cambiadoEl           DateTime @default(now()) @map("cambiado_el")
  cambiadoPorId        Int      @map("cambiado_por")
  solicitudId          Int?     @map("solicitud_id")

  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  cambiadoPor Usuario  @relation(fields: [cambiadoPorId], references: [id], onDelete: Restrict)

  @@index([pacienteId, campo])
  @@map("historial_cambios")
}

// Verificación de identidad del titular: con la cédula en admisión o con un
// código de un solo uso enviado al contacto registrado (solo su hash).
model VerificacionIdentidad {
  id              Int       @id @default(autoincrement())
  pacienteId      Int       @map("paciente_id")
  metodo          String // 'cedula_presencial' | 'codigo_contacto'
  verificadaPorId Int       @map("verificada_por")
  creadaEl        DateTime  @default(now()) @map("creada_el")
  verificadaEl    DateTime? @map("verificada_el")
  codigoHash      Bytes?    @map("codigo_hash")
  sal             Bytes?
  expiraEl        DateTime? @map("expira_el")
  intentos        Int       @default(0)

  paciente      Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  verificadaPor Usuario  @relation(fields: [verificadaPorId], references: [id], onDelete: Restrict)

  @@index([pacienteId, verificadaPorId])
  @@map("verificaciones_identidad")
}

model Cita {
  id          Int      @id @default(autoincrement())
  pacienteId  Int      @map("paciente_id")
  medicoId    Int      @map("medico_id")
  boxId       Int      @map("box_id")
  fecha       DateTime @db.Date
  horaInicio  String   @map("hora_inicio")
  horaFin     String   @map("hora_fin")
  estado      String   @default("agendada")
  anulada     Boolean  @default(false)
  // Motivo de consulta de esta cita, cifrado con PACIENTE_CLINICO_KEY.
  motivoConsultaCifrado Bytes? @map("motivo_consulta_cifrado")
  updatedById Int?     @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  paciente  Paciente @relation(fields: [pacienteId], references: [id])
  medico    Medico   @relation(fields: [medicoId], references: [id])
  box       Box      @relation(fields: [boxId], references: [id])
  updatedBy Usuario? @relation("CitaUpdatedBy", fields: [updatedById], references: [id])

  @@index([boxId, fecha])
  @@index([medicoId, fecha])
  @@map("citas")
}

// Rastro de auditoría: solo ids y metadatos, nunca el dato personal mismo.
model AuditLog {
  id        Int      @id @default(autoincrement())
  // Null cuando actúa el sistema o cuando falla un login con un correo que no
  // existe (en ese caso queda emailIndice).
  usuarioId Int?     @map("usuario_id")
  actor     String   @default("usuario") // 'usuario' | 'sistema'
  accion    String
  entidad   String
  entidadId Int      @map("entidad_id")
  resultado String   @default("exito") // 'exito' | 'denegado' | 'fallido'
  ip        String?
  // HMAC del correo de un login fallido (AUDITORIA_HMAC_KEY).
  emailIndice Bytes? @map("email_indice")
  // Conteos o referencias internas, sin datos personales.
  detalle   Json?
  timestamp DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([entidad, entidadId])
  @@index([accion, timestamp])
  @@map("audit_log")
}

model Notificacion {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  mensaje   String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("notificaciones")
}
