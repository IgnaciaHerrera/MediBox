generator client {
  provider        = "prisma-client-js"
  // `omit` permite que las consultas de citas no traigan el motivo cifrado
  // salvo cuando se pide explícitamente (src/lib/prisma.js).
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rolId        Int      @map("rol_id")
  createdAt    DateTime @default(now()) @map("created_at")
  // Contención de una cuenta comprometida: no inicia sesión y sus sesiones
  // abiertas se cortan en la petición siguiente.
  suspendida   Boolean   @default(false)
  suspendidaEl DateTime? @map("suspendida_el")

  rol                        Rol                     @relation(fields: [rolId], references: [id])
  citasEditadas              Cita[]                  @relation("CitaUpdatedBy")
  auditLogs                  AuditLog[]
  notificaciones             Notificacion[]
  medico                     Medico?
  cambiosHechos              HistorialCambio[]
  verificaciones             VerificacionIdentidad[]
  consentimientosRegistrados Consentimiento[]        @relation("ConsentimientoRegistradoPor")
  revocacionesRegistradas    Consentimiento[]        @relation("ConsentimientoRevocadoPor")
  solicitudesRecibidas       SolicitudDerecho[]      @relation("SolicitudRecibidaPor")
  solicitudesVerificadas     SolicitudDerecho[]      @relation("SolicitudVerificadaPor")
  solicitudesResueltas       SolicitudDerecho[]      @relation("SolicitudResueltaPor")
  incidentesRegistrados      Incidente[]

  @@map("usuarios")
}

model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  descripcion String?
  usuarios    Usuario[]
  permisos    RolPermiso[]

  @@map("roles")
}

model Permiso {
  id    Int          @id @default(autoincrement())
  clave String       @unique
  roles RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     Int @map("rol_id")
  permisoId Int @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
  @@map("rol_permisos")
}

model Especialidad {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique
  medicos Medico[]

  @@map("especialidades")
}

model Medico {
  id             Int    @id @default(autoincrement())
  nombre         String
  especialidadId Int    @map("especialidad_id")
  usuarioId      Int?   @unique @map("usuario_id")

  especialidad Especialidad @relation(fields: [especialidadId], references: [id])
  usuario      Usuario?     @relation(fields: [usuarioId], references: [id])
  citas        Cita[]

  @@map("medicos")
}

model Pasillo {
  id     Int    @id @default(autoincrement())
  nombre String @unique
  boxes  Box[]

  @@map("pasillos")
}

model Box {
  id        Int    @id @default(autoincrement())
  nombre    String
  pasilloId Int    @map("pasillo_id")

  pasillo      Pasillo       @relation(fields: [pasilloId], references: [id])
  instrumentos Instrumento[]
  citas        Cita[]

  @@unique([pasilloId, nombre])
  @@map("boxes")
}

model Instrumento {
  id     Int    @id @default(autoincrement())
  nombre String
  boxId  Int    @map("box_id")

  box Box @relation(fields: [boxId], references: [id])

  @@map("instrumentos")
}

// Los datos personales se cifran en la aplicación con AES-256-GCM
// (src/lib/cifrado.js); la base de datos solo ve blobs cifrados.
model Paciente {
  id                     Int       @id @default(autoincrement())
  nombreCifrado          Bytes     @map("nombre_cifrado")
  rutCifrado             Bytes     @map("rut_cifrado")
  // HMAC-SHA256 del RUT normalizado: búsqueda exacta y unicidad sin descifrar.
  rutIndice              Bytes     @unique @map("rut_indice")
  // AAAA-MM-DD cifrada con la llave de identidad: es un cuasi identificador
  // y la que revela si el paciente es menor de edad.
  fechaNacimientoCifrada Bytes     @map("fecha_nacimiento_cifrada")
  // Opcional: solo sirve para avisar al paciente de cambios en sus citas.
  contactoCifrado        Bytes?    @map("contacto_cifrado")
  // Bloqueado (por un bloqueo o una supresión): se conserva, porque la Ley
  // 20.584 obliga a guardar el registro clínico, pero no se usa para nada. El
  // motivo sale de la solicitud que lo originó.
  bloqueado              Boolean   @default(false)
  bloqueadoEl            DateTime? @map("bloqueado_el")
  createdAt              DateTime  @default(now()) @map("created_at")

  citas           Cita[]
  cambios         HistorialCambio[]
  verificaciones  VerificacionIdentidad[]
  consentimientos Consentimiento[]
  solicitudes     SolicitudDerecho[]

  @@map("pacientes")
}

// Rectificación: por cada campo que cambió, su valor anterior cifrado con la
// llave de su categoría ('historial.<campo>'). El valor nuevo ya está en el
// paciente.
model HistorialCambio {
  id                   Int      @id @default(autoincrement())
  pacienteId           Int      @map("paciente_id")
  campo                String // 'nombre' | 'rut' | 'fechaNacimiento' | 'contacto'
  valorAnteriorCifrado Bytes?   @map("valor_anterior_cifrado")
  cambiadoEl           DateTime @default(now()) @map("cambiado_el")
  cambiadoPorId        Int      @map("cambiado_por")
  solicitudId          Int?     @map("solicitud_id")

  paciente    Paciente          @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  cambiadoPor Usuario           @relation(fields: [cambiadoPorId], references: [id], onDelete: Restrict)
  solicitud   SolicitudDerecho? @relation(fields: [solicitudId], references: [id], onDelete: Restrict)

  @@index([pacienteId, campo])
  @@map("historial_cambios")
}

// Verificación de identidad del titular: con la cédula en admisión o con un
// código de un solo uso enviado al contacto registrado (solo su hash).
model VerificacionIdentidad {
  id              Int       @id @default(autoincrement())
  pacienteId      Int       @map("paciente_id")
  metodo          String // 'cedula_presencial' | 'codigo_contacto' | 'codigo_portal'
  // Vacío solo en el portal del titular, donde no verifica un funcionario.
  verificadaPorId Int?      @map("verificada_por")
  creadaEl        DateTime  @default(now()) @map("creada_el")
  verificadaEl    DateTime? @map("verificada_el")
  codigoHash      Bytes?    @map("codigo_hash")
  sal             Bytes?
  expiraEl        DateTime? @map("expira_el")
  intentos        Int       @default(0)

  paciente      Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  verificadaPor Usuario? @relation(fields: [verificadaPorId], references: [id], onDelete: Restrict)

  consentimientosOtorgados Consentimiento[]   @relation("ConsentimientoVerificacion")
  consentimientosRevocados Consentimiento[]   @relation("ConsentimientoRevocacionVerificacion")
  solicitudes              SolicitudDerecho[]

  @@index([pacienteId, verificadaPorId])
  @@map("verificaciones_identidad")
}

// Finalidades secundarias que requieren consentimiento (D1). La atención no
// está aquí: no depende de él.
model Finalidad {
  id              Int                   @id @default(autoincrement())
  clave           String                @unique // 'recordatorios' | 'investigacion' | 'encuestas'
  nombre          String
  descripcion     String
  activa          Boolean               @default(true)
  // Si trata datos sensibles: entonces un menor de 16 (no de 14) consiente
  // por medio de su representante (Ley 21.719, art. 16 quáter).
  datosSensibles  Boolean               @default(false) @map("datos_sensibles")
  textos          TextoConsentimiento[]
  consentimientos Consentimiento[]

  @@map("finalidades")
}

// Versiones del texto informativo. Un texto nuevo es una versión nueva.
model TextoConsentimiento {
  id              Int              @id @default(autoincrement())
  finalidadId     Int              @map("finalidad_id")
  version         Int
  texto           String
  vigenteDesde    DateTime         @default(now()) @map("vigente_desde")
  finalidad       Finalidad        @relation(fields: [finalidadId], references: [id], onDelete: Restrict)
  consentimientos Consentimiento[]

  @@unique([finalidadId, version])
  @@map("textos_consentimiento")
}

// Un registro por otorgamiento. Revocar llena revocadoEl: nunca se borra.
model Consentimiento {
  id                        Int       @id @default(autoincrement())
  pacienteId                Int       @map("paciente_id")
  finalidadId               Int       @map("finalidad_id")
  textoId                   Int       @map("texto_id")
  otorgadoEl                DateTime  @default(now()) @map("otorgado_el")
  canal                     String // 'presencial' | 'telefono' | 'correo' | 'portal'
  otorgadoPor               String    @map("otorgado_por") // 'titular' | 'representante'
  representanteCifrado      Bytes?    @map("representante_cifrado")
  // Vacío solo si lo registró el propio titular en el portal.
  registradoPorId           Int?      @map("registrado_por")
  verificacionId            Int       @map("verificacion_id")
  revocadoEl                DateTime? @map("revocado_el")
  revocacionCanal           String?   @map("revocacion_canal")
  revocacionRegistradaPorId Int?      @map("revocacion_registrada_por")
  revocacionVerificacionId  Int?      @map("revocacion_verificacion_id")

  paciente                Paciente               @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  finalidad               Finalidad              @relation(fields: [finalidadId], references: [id], onDelete: Restrict)
  texto                   TextoConsentimiento    @relation(fields: [textoId], references: [id], onDelete: Restrict)
  registradoPor           Usuario?               @relation("ConsentimientoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  revocacionRegistradaPor Usuario?               @relation("ConsentimientoRevocadoPor", fields: [revocacionRegistradaPorId], references: [id], onDelete: Restrict)
  verificacion            VerificacionIdentidad  @relation("ConsentimientoVerificacion", fields: [verificacionId], references: [id], onDelete: Restrict)
  revocacionVerificacion  VerificacionIdentidad? @relation("ConsentimientoRevocacionVerificacion", fields: [revocacionVerificacionId], references: [id], onDelete: Restrict)

  @@index([pacienteId, finalidadId])
  @@map("consentimientos")
}

model Cita {
  id                    Int      @id @default(autoincrement())
  pacienteId            Int      @map("paciente_id")
  medicoId              Int      @map("medico_id")
  boxId                 Int      @map("box_id")
  fecha                 DateTime @db.Date
  horaInicio            String   @map("hora_inicio")
  horaFin               String   @map("hora_fin")
  estado                String   @default("agendada")
  anulada               Boolean  @default(false)
  // Motivo de consulta de esta cita, cifrado con PACIENTE_CLINICO_KEY.
  motivoConsultaCifrado Bytes?   @map("motivo_consulta_cifrado")
  updatedById           Int?     @map("updated_by")
  updatedAt             DateTime @updatedAt @map("updated_at")
  createdAt             DateTime @default(now()) @map("created_at")

  paciente  Paciente @relation(fields: [pacienteId], references: [id])
  medico    Medico   @relation(fields: [medicoId], references: [id])
  box       Box      @relation(fields: [boxId], references: [id])
  updatedBy Usuario? @relation("CitaUpdatedBy", fields: [updatedById], references: [id])

  @@index([boxId, fecha])
  @@index([medicoId, fecha])
  @@map("citas")
}

// Rastro de auditoría: solo ids y metadatos, nunca el dato personal mismo.
model AuditLog {
  id          Int      @id @default(autoincrement())
  // Null cuando actúa el sistema o cuando falla un login con un correo que no
  // existe (en ese caso queda emailIndice).
  usuarioId   Int?     @map("usuario_id")
  // 'usuario' | 'sistema' | 'titular' (en el portal, ya verificado) | 'portal'
  // (en el portal, antes de verificar: quien pide o prueba un código)
  actor       String   @default("usuario")
  accion      String
  entidad     String
  entidadId   Int      @map("entidad_id")
  resultado   String   @default("exito") // 'exito' | 'denegado' | 'fallido'
  ip          String?
  // HMAC del correo de un login fallido (AUDITORIA_HMAC_KEY).
  emailIndice Bytes?   @map("email_indice")
  // Conteos o referencias internas, sin datos personales.
  detalle     Json?
  timestamp   DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([entidad, entidadId])
  @@index([accion, timestamp])
  @@map("audit_log")
}

model Notificacion {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  mensaje   String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("notificaciones")
}

// Sesiones de express-session (connect-pg-simple). Las crea la migración y no
// la aplicación, que no puede crear tablas (rol medibox_app).
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// Solicitud de un derecho del titular (ARCO+). La registra un funcionario por
// cualquier canal; se ejecuta solo con la identidad verificada por el método
// que acepta el derecho. Lo pedido y lo respondido van cifrados.
model SolicitudDerecho {
  id                         Int       @id @default(autoincrement())
  pacienteId                 Int       @map("paciente_id")
  derecho                    String // acceso | portabilidad | rectificacion | supresion | bloqueo | oposicion
  estado                     String    @default("recibida") // recibida | verificada | resuelta | rechazada
  canal                      String // presencial | telefono | correo | portal
  recibidaEl                 DateTime  @default(now()) @map("recibida_el")
  venceEl                    DateTime  @map("vence_el")
  // Vacío solo si la presentó el propio titular en el portal.
  recibidaPorId              Int?      @map("recibida_por")
  solicitanteEsRepresentante Boolean   @default(false) @map("solicitante_es_representante")
  solicitanteRelacion        String?   @map("solicitante_relacion")
  // Documento con que el representante acreditó la representación (solo el
  // tipo, nunca una copia): certificado_nacimiento | resolucion_judicial |
  // poder_notarial, o 'declarada' si no lo mostró (portal, teléfono).
  solicitanteAcreditacion    String?   @map("solicitante_acreditacion")
  campo                      String? // rectificación: nombre | rut | fechaNacimiento | contacto
  valorPropuestoCifrado      Bytes?    @map("valor_propuesto_cifrado")
  finalidadClave             String?   @map("finalidad_clave") // oposición
  identidadVerificada        Boolean   @default(false) @map("identidad_verificada")
  metodoVerificacion         String?   @map("metodo_verificacion")
  verificacionId             Int?      @map("verificacion_id")
  verificadaPorId            Int?      @map("verificada_por")
  entrega                    String? // acceso y portabilidad: contacto_registrado | presencial | portal
  respuestaCifrada           Bytes?    @map("respuesta_cifrada")
  verificadaEl               DateTime? @map("verificada_el")
  // Al cerrar: atendida | parcial (denegación parcial, p. ej. la supresión,
  // que conserva lo clínico) | rechazada.
  resultado                  String?
  // El plazo se prorroga una sola vez, hasta por 30 días (Ley 21.719, art. 11).
  prorrogadaEl               DateTime? @map("prorrogada_el")
  prorrogaMotivoCifrado      Bytes?    @map("prorroga_motivo_cifrado")
  resueltaEl                 DateTime? @map("resuelta_el")
  resueltaPorId              Int?      @map("resuelta_por")

  paciente      Paciente               @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  recibidaPor   Usuario?               @relation("SolicitudRecibidaPor", fields: [recibidaPorId], references: [id], onDelete: Restrict)
  verificadaPor Usuario?               @relation("SolicitudVerificadaPor", fields: [verificadaPorId], references: [id], onDelete: Restrict)
  resueltaPor   Usuario?               @relation("SolicitudResueltaPor", fields: [resueltaPorId], references: [id], onDelete: Restrict)
  verificacion  VerificacionIdentidad? @relation(fields: [verificacionId], references: [id], onDelete: Restrict)
  cambios       HistorialCambio[]

  @@index([pacienteId])
  @@index([estado, venceEl])
  @@map("solicitudes_derechos")
}

// Registro de incidentes de seguridad (Ley 21.719, art. 14 sexies): solo
// conteos y categorías, nunca datos de pacientes. alerta -> sospechoso ->
// confirmado -> cerrado, o descartado.
model Incidente {
  id                    Int       @id @default(autoincrement())
  titulo                String
  origen                String // alerta_automatica | reporte_funcionario | reporte_titular | hallazgo_externo
  estado                String    @default("alerta")
  severidad             String    @default("media") // baja | media | alta | critica
  dimension             String // confidencialidad | integridad | disponibilidad
  descripcion           String
  detectadoEl           DateTime  @default(now()) @map("detectado_el")
  ocurridoDesde         DateTime? @map("ocurrido_desde")
  ocurridoHasta         DateTime? @map("ocurrido_hasta")
  categoriasDatos       String[]  @default([]) @map("categorias_datos")
  titularesAfectados    Int?      @map("titulares_afectados")
  incluyeMenores        Boolean   @default(false) @map("incluye_menores")
  consecuencias         String?
  medidas               String?
  recomendaciones       String?
  lecciones             String?
  sinNotificacionMotivo String?   @map("sin_notificacion_motivo")
  notificadoAgenciaEl   DateTime? @map("notificado_agencia_el")
  notificadoTitularesEl DateTime? @map("notificado_titulares_el")
  notificadoCsirtEl     DateTime? @map("notificado_csirt_el")
  cerradoEl             DateTime? @map("cerrado_el")
  registradoPorId       Int       @map("registrado_por")
  actualizadoEl         DateTime  @default(now()) @updatedAt @map("actualizado_el")

  registradoPor Usuario @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)

  @@index([estado])
  @@map("incidentes")
}
