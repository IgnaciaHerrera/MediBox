<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo }) %>
</head>
<body class="login-body">
  <div class="login-shell">
    <aside class="login-brand">
      <div class="login-logo">
        <span class="login-logo-icono" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="17" height="17" rx="4"/><path d="M12 8v8M8 12h8"/></svg>
        </span>
        <span class="login-wordmark">MediBox</span>
      </div>

      <div class="login-brand-cuerpo">
        <p class="login-eyebrow">Sistema interno del hospital</p>
        <h2 class="login-titular">Agenda y espacios clínicos, en un solo lugar.</h2>

        <ul class="login-puntos">
          <li>
            <span class="login-punto-icono" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/></svg>
            </span>
            <span><strong>Agenda médica</strong> Citas por médico, box y día.</span>
          </li>
          <li>
            <span class="login-punto-icono" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="1.5"/><circle cx="15" cy="12" r=".8" fill="currentColor" stroke="none"/></svg>
            </span>
            <span><strong>Boxes y pasillos</strong> Qué está libre u ocupado en este momento.</span>
          </li>
          <li>
            <span class="login-punto-icono" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <span><strong>Datos protegidos</strong> Información de pacientes cifrada y auditada.</span>
          </li>
        </ul>
      </div>

      <div class="login-brand-foot">© 2026 MediBox</div>
    </aside>

    <main class="login-form-panel">
      <div class="login-card">
        <p class="login-card-eyebrow">Acceso al sistema</p>
        <h1>Iniciar sesión</h1>
        <p class="login-card-sub">Ingresa con tu correo institucional.</p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="login-error" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4.5"/><path d="M12 16h.01"/></svg>
            <p class="field-error"><%= error %></p>
          </div>
        <% } %>

        <form method="POST" action="/auth/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div class="field">
            <label for="email">Correo institucional</label>
            <div class="login-input">
              <svg class="login-input-icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg>
              <input type="email" id="email" name="email" autocomplete="username" placeholder="nombre@medibox.cl" required autofocus />
            </div>
          </div>

          <div class="field">
            <label for="password">Contraseña</label>
            <div class="password-field login-input">
              <svg class="login-input-icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              <input type="password" id="password" name="password" autocomplete="current-password" required />
              <button
                type="button"
                class="password-toggle"
                data-password-toggle
                aria-controls="password"
                aria-pressed="false"
                aria-label="Mostrar contraseña"
              >
                <svg data-icon-visible viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
                <svg data-icon-hidden hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" />
                  <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" />
                  <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" />
                  <path d="m2 2 20 20" />
                </svg>
              </button>
            </div>
          </div>

          <button type="submit" class="btn btn-primary login-entrar">
            Entrar
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </form>

        <p class="login-card-nota">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/></svg>
          Acceso exclusivo para el personal autorizado del hospital.
        </p>
      </div>

      <p class="login-ayuda">¿Problemas para entrar? Pídele ayuda a un administrador.</p>
    </main>
  </div>
  <script src="/js/login.js"></script>
</body>
</html>
