<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head', { titulo }) %>
<%
  const rolAdmin = roles.find(function (r) { return r.nombre === 'admin'; });
%>
</head>
<body>
  <%- include('../partials/topbar', { usuario, csrfToken, activo: 'roles' }) %>

  <main class="page-main">
    <div class="page-head">
      <div>
        <h1>Roles y permisos</h1>
        <p class="page-sub">Marca o desmarca los permisos de cada rol. Los cambios no se aplican hasta que presiones «Guardar cambios».</p>
      </div>
    </div>

    <% if (error) { %>
      <p class="field-error" role="alert"><%= error %></p>
    <% } %>

    <form method="POST" action="/roles/actualizar-todo" id="form-matriz">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <% roles.forEach(function(rol) { %>
        <input type="hidden" name="rolesEnviados" value="<%= rol.id %>" />
      <% }) %>
      <% if (rolAdmin) { %>
        <input type="hidden" name="permisos_<%= rolAdmin.id %>" value="admin.roles" />
      <% } %>

      <div class="panel-card panel-card--tabla matriz-envoltorio">
        <div class="matriz-scroll">
          <table class="matriz">
            <thead>
              <tr>
                <th>Permiso</th>
                <% roles.forEach(function(rol) { %>
                  <th><span class="rol-chip rol-chip--<%= rol.nombre %>"><%= rol.nombre %></span></th>
                <% }) %>
              </tr>
            </thead>
            <tbody>
              <% grupos.forEach(function(grupo) { %>
                <tr class="matriz-grupo">
                  <td colspan="<%= roles.length + 1 %>"><%= grupo.etiqueta %></td>
                </tr>
                <% grupo.permisos.forEach(function(permiso) { %>
                  <tr>
                    <td><%= permiso.etiqueta %></td>
                    <% roles.forEach(function(rol) { %>
                      <%
                        const esAdminRoles = rol.nombre === 'admin' && permiso.clave === 'admin.roles';
                      %>
                      <td>
                        <input
                          type="checkbox"
                          name="permisos_<%= rol.id %>"
                          value="<%= permiso.clave %>"
                          aria-label="<%= permiso.etiqueta %> — <%= rol.nombre %><%= esAdminRoles ? ' (el administrador siempre lo conserva)' : '' %>"
                          <%= rol.clavesActivas.has(permiso.clave) ? 'checked' : '' %>
                          <%= esAdminRoles ? 'disabled title="El administrador siempre conserva este permiso"' : '' %>
                        />
                      </td>
                    <% }) %>
                  </tr>
                <% }) %>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </form>
  </main>

  <div class="barra-guardar" id="barra-guardar" role="status" aria-live="polite" hidden>
    <span class="barra-guardar-icono" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9l-4-4L4 16v4Z"/><path d="m13.5 6.5 4 4"/></svg>
    </span>
    <span id="barra-guardar-texto">Cambios sin guardar</span>
    <div class="barra-guardar-acciones">
      <button type="reset" form="form-matriz" class="btn btn--auto barra-btn-descartar">Descartar</button>
      <button type="submit" form="form-matriz" class="btn btn--auto barra-btn-guardar">Guardar cambios</button>
    </div>
  </div>

  <script src="/js/roles.js"></script>
</body>
</html>
