<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head', { titulo }) %>
<%
  const cuerpoRut = paciente.rut.slice(0, -1);
  const dvRut = paciente.rut.slice(-1);
  const rutEnmascarado = '•'.repeat(cuerpoRut.length) + '-' + dvRut;

  function iniciales(nombre) {
    const partes = nombre.trim().split(/\s+/);
    const primera = partes[0] ? partes[0][0] : '';
    const ultima = partes.length > 1 ? partes[partes.length - 1][0] : '';
    return (primera + ultima).toUpperCase();
  }

  function calcularEdad(fechaNacimiento) {
    const hoy = new Date();
    const nacimiento = new Date(fechaNacimiento);
    let edad = hoy.getFullYear() - nacimiento.getFullYear();
    const noHaCumplidoAnios = hoy.getMonth() < nacimiento.getMonth()
      || (hoy.getMonth() === nacimiento.getMonth() && hoy.getDate() < nacimiento.getDate());
    if (noHaCumplidoAnios) edad -= 1;
    return edad;
  }

  const edad = calcularEdad(paciente.fechaNacimiento);
%>
</head>
<body>
  <%- include('../partials/topbar', { usuario, csrfToken, activo: 'pacientes' }) %>

  <main class="page-main">
    <a class="volver" href="/pacientes">← Volver a pacientes</a>

    <div class="page-head page-head--perfil">
      <div class="fila-persona">
        <span class="avatar avatar--grande"><%= iniciales(paciente.nombre) %></span>
        <div>
          <h1><%= paciente.nombre %></h1>
          <p class="paciente-subtitulo"><%= edad %> años · paciente desde <%= fechaDMA(isoLocal(paciente.createdAt).slice(0, 10)) %></p>
        </div>
      </div>
      <div class="page-head-acciones">
        <% if (puedeEditar) { %>
          <a href="/pacientes/<%= paciente.id %>/editar" class="btn btn-neutro btn--auto btn--control btn--icono">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4Z"/><path d="m13.5 6.5 4 4"/></svg>
            Editar
          </a>
        <% } %>
      </div>
    </div>

    <div class="cita-grid<%= citas ? '' : ' cita-grid--una' %>">
      <section class="panel-card cita-seccion" aria-labelledby="paciente-datos-titulo">
        <div class="cita-seccion-head">
          <span class="cita-seccion-icono" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M6 16c.6-1.5 1.7-2.3 3-2.3s2.4.8 3 2.3M14.5 10h4M14.5 13.5h3"/></svg>
          </span>
          <h2 id="paciente-datos-titulo">Datos personales</h2>
        </div>
        <div class="detalle-grid detalle-grid--sin-margen detalle-grid--una">
          <div class="detalle-item">
            <span class="etiqueta">RUT</span>
            <div class="rut-fila">
              <span class="valor tiempo rut-valor" data-rut="<%= paciente.rut %>" data-rut-oculto="<%= rutEnmascarado %>"><%= rutEnmascarado %></span>
              <button type="button" class="btn-mini" id="btn-mostrar-rut">Mostrar</button>
            </div>
          </div>
          <div class="detalle-item">
            <span class="etiqueta">Fecha de nacimiento</span>
            <span class="valor tiempo"><%= fechaDMA(new Date(paciente.fechaNacimiento).toISOString().slice(0, 10)) %></span>
          </div>
          <div class="detalle-item">
            <span class="etiqueta">Contacto</span>
            <span class="valor"><%= paciente.contacto %></span>
          </div>
        </div>
      </section>

      <% if (citas) { %>
        <% const proxima = citas.proximas[0]; %>
        <section class="panel-card cita-seccion" aria-labelledby="paciente-proxima-titulo">
          <div class="cita-seccion-head">
            <span class="cita-seccion-icono" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/><path d="M12 13v3l2 1"/></svg>
            </span>
            <h2 id="paciente-proxima-titulo">Próxima cita</h2>
          </div>
          <% if (proxima) { %>
            <div class="detalle-grid detalle-grid--sin-margen">
              <div class="detalle-item">
                <span class="etiqueta">Fecha</span>
                <span class="valor tiempo"><%= fechaDMA(proxima.fecha.toISOString().slice(0, 10)) %> · <%= proxima.horaInicio %>–<%= proxima.horaFin %></span>
              </div>
              <div class="detalle-item">
                <span class="etiqueta">Box</span>
                <span class="valor"><%= proxima.box.pasillo.nombre %> · <%= proxima.box.nombre %></span>
              </div>
              <div class="detalle-item">
                <span class="etiqueta">Médico</span>
                <span class="valor"><%= proxima.medico.nombre %></span>
              </div>
              <div class="detalle-item">
                <span class="etiqueta">Motivo de consulta</span>
                <span class="valor"><%= proxima.motivoConsulta || 'Sin motivo registrado' %></span>
              </div>
            </div>
            <a class="btn-mini paciente-proxima-ver" href="/agenda/<%= proxima.id %>">Ver cita →</a>
          <% } else { %>
            <p class="paciente-proxima-vacio">No tiene citas agendadas por delante.</p>
          <% } %>
        </section>
      <% } %>
    </div>

    <% if (citas) { %>
      <%
        const totalCitas = citas.proximas.length + citas.totalHistorial;
        const gruposCitas = [
          { titulo: 'Próximas', items: citas.proximas, vacio: 'No tiene citas agendadas por delante.' },
          { titulo: 'Historial', items: citas.historial, vacio: 'Todavía no tiene citas pasadas.', paginado: true },
        ];
      %>
      <section class="panel-card panel-lista paciente-citas" id="citas" aria-labelledby="paciente-citas-titulo">
        <div class="panel-lista-head">
          <h2 id="paciente-citas-titulo">Citas <span class="paciente-citas-total"><%= totalCitas %></span></h2>
          <% if (puedeAgendar) { %>
            <a href="/agenda/nueva" class="btn btn-neutro btn--auto btn--control btn--icono">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              Agendar cita
            </a>
          <% } %>
        </div>

        <% if (totalCitas === 0) { %>
          <p class="panel-lista-vacio">Este paciente todavía no tiene citas.</p>
        <% } else { %>
          <% gruposCitas.forEach(function(grupo) { %>
            <div class="paciente-citas-grupo">
              <h3 class="paciente-citas-subtitulo"><%= grupo.titulo %></h3>
              <% if (grupo.items.length === 0) { %>
                <p class="paciente-citas-vacio"><%= grupo.vacio %></p>
              <% } else { %>
                <div class="tabla-scroll">
                  <table class="tabla">
                    <thead>
                      <tr>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Box</th>
                        <th>Médico</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% grupo.items.forEach(function(cita) { %>
                        <% const estado = cita.anulada ? 'anulada' : cita.estado; %>
                        <tr>
                          <td class="tiempo"><%= fechaDMA(cita.fecha.toISOString().slice(0, 10)) %></td>
                          <td><span class="cita-hora tiempo"><%= cita.horaInicio %>–<%= cita.horaFin %></span></td>
                          <td><%= cita.box.pasillo.nombre %> · <%= cita.box.nombre %></td>
                          <td>
                            <span class="fila-persona">
                              <span class="avatar" aria-hidden="true"><%= iniciales(cita.medico.nombre) %></span>
                              <a class="fila-link fila-link--fila" href="/agenda/<%= cita.id %>"><%= cita.medico.nombre %></a>
                            </span>
                          </td>
                          <td class="paciente-citas-motivo" title="<%= cita.motivoConsulta || '' %>"><%= cita.motivoConsulta || '—' %></td>
                          <td><span class="badge badge-<%= estado %>"><%= estado.replace('_', ' ') %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
                <% if (grupo.paginado && citas.totalPaginas > 1) { %>
                  <div class="paginacion panel-lista-pie">
                    <span class="paginacion-info"><%= citas.totalHistorial %> cita<%= citas.totalHistorial === 1 ? '' : 's' %> en el historial — página <%= citas.page %> de <%= citas.totalPaginas %></span>
                    <div class="paginacion-nav">
                      <% if (citas.page > 1) { %><a href="/pacientes/<%= paciente.id %>?page=<%= citas.page - 1 %>#citas" class="btn btn-neutro btn--auto btn--control">← Anterior</a><% } %>
                      <% if (citas.page < citas.totalPaginas) { %><a href="/pacientes/<%= paciente.id %>?page=<%= citas.page + 1 %>#citas" class="btn btn-neutro btn--auto btn--control">Siguiente →</a><% } %>
                    </div>
                  </div>
                <% } %>
              <% } %>
            </div>
          <% }) %>
        <% } %>
      </section>
    <% } %>
  </main>
  <script src="/js/pacientes-detalle.js"></script>
</body>
</html>
