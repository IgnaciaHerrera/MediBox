<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head', { titulo }) %>
<%
  const e = etiquetas;
  const t = datos.titular;
  const nombrePila = t.nombre.trim().split(/\s+/)[0];
  const sesionHasta = isoLocal(expiraEl).slice(11, 16);

  const AHORA = isoLocal(new Date());
  const HOY = AHORA.slice(0, 10);
  const HORA = AHORA.slice(11, 16);

  // 15234876-3 -> 15.234.876-3
  function rutConPuntos(rut) {
    const limpio = String(rut).replace(/[^0-9kK]/g, '');
    if (limpio.length < 2) return rut;
    return limpio.slice(0, -1).replace(/\B(?=(\d{3})+(?!\d))/g, '.') + '-' + limpio.slice(-1).toUpperCase();
  }

  function iniciales(nombre) {
    const partes = nombre.replace(/^Dra?\.\s+/, '').trim().split(/\s+/);
    return ((partes[0] ? partes[0][0] : '') + (partes.length > 1 ? partes[partes.length - 1][0] : '')).toUpperCase();
  }

  // Citas: las que vienen (agendadas que aún no terminan) y las anteriores.
  const esProxima = (c) => !c.anulada && c.estado === 'agendada' && (c.fecha > HOY || (c.fecha === HOY && c.horaFin > HORA));
  const clave = (c) => c.fecha + ' ' + c.horaInicio;
  const proximas = datos.citas.filter(esProxima).sort((a, b) => (clave(a) < clave(b) ? -1 : 1));
  const anteriores = datos.citas.filter((c) => !esProxima(c)).sort((a, b) => (clave(a) < clave(b) ? 1 : -1));
  const proxima = proximas[0];
  const estadoCita = (c) => (c.anulada ? ['anulada', 'Anulada'] : [c.estado, e.estadoCita[c.estado] || c.estado]);

  // Clase de la etiqueta (las mismas del resto de la app) según el estado.
  const CONSENTIMIENTO = {
    vigente: ['Vigente', 'badge-atendido'],
    revocado: ['Revocado', 'badge-neutro'],
    a_renovar: ['Debes aceptarlo de nuevo', 'badge-agendada'],
    sin_otorgar: ['No otorgado', 'badge-neutro'],
  };
  const consentimientosVigentes = datos.estadoConsentimientos.filter((c) => c.estado === 'vigente').length;

  const ESTADO_SOLICITUD = { recibida: 'badge-agendada', verificada: 'badge-agendada', resuelta: 'badge-atendido', rechazada: 'badge-anulada' };
  const solicitudesPendientes = datos.solicitudes.filter((s) => s.estado === 'recibida' || s.estado === 'verificada').length;

  const DERECHOS_TEXTO = {
    acceso: 'Saber qué datos tuyos se tratan, para qué y a quién se comunican: es esta página.',
    portabilidad: 'Recibir tus datos en un formato estructurado (Excel) para llevarlos a otro responsable.',
    rectificacion: 'Corregir un dato erróneo o incompleto.',
    supresion: 'Pedir que se eliminen los datos que el hospital no está obligado a conservar.',
    oposicion: 'Negarte a los usos opcionales: es revocar el consentimiento de ese uso.',
    bloqueo: 'Suspender el uso de tus datos mientras se aclara una duda sobre ellos.',
  };

  const SECCIONES = [
    { id: 'resumen', nombre: 'Resumen', icono: 'resumen' },
    { id: 'citas', nombre: 'Mis citas', icono: 'citas' },
    { id: 'consentimientos', nombre: 'Consentimientos', icono: 'consentimientos' },
    { id: 'derechos', nombre: 'Derechos', icono: 'derechos', cuenta: solicitudesPendientes },
    { id: 'actividad', nombre: 'Actividad', icono: 'actividad' },
    { id: 'descargas', nombre: 'Descargas', icono: 'descargas' },
    { id: 'uso', nombre: 'Uso de mis datos', icono: 'uso' },
  ];

  const ICONO = {
    persona: '<circle cx="12" cy="8" r="3.2"/><path d="M5 20c1.2-4 4-6 7-6s5.8 2 7 6"/>',
    agenda: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/>',
    escudo: '<path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
    lapiz: '<path d="M4 20h4L19 9l-4-4L4 16v4Z"/><path d="m13.5 6.5 4 4"/>',
    excel: '<rect x="3.5" y="4" width="17" height="16" rx="2"/><path d="M3.5 9h17M3.5 14h17M9.5 4v16"/>',
    pdf: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h7M9 16h5"/>',
    usuarios: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    sello: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  };
  const svg = (nombre) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">' + ICONO[nombre] + '</svg>';
%>
</head>
<body>
  <%- include('../partials/portal-topbar', { sesionHasta, csrfToken, nombre: t.nombre, secciones: SECCIONES }) %>

  <main class="page-main" data-portal-datos>

    <!-- ===== Resumen ===== -->
    <section class="portal-seccion" id="resumen" data-panel="resumen" aria-labelledby="titulo-resumen">
      <div class="page-head">
        <div>
          <h1 id="titulo-resumen">Hola, <%= nombrePila %></h1>
          <p class="page-sub">Aquí ves y gestionas tus datos. Todo lo que haces queda registrado.</p>
        </div>
      </div>

      <div class="cita-grid">
        <section class="panel-card cita-seccion" aria-labelledby="resumen-datos">
          <div class="cita-seccion-head">
            <span class="cita-seccion-icono" aria-hidden="true"><%- svg('persona') %></span>
            <h2 id="resumen-datos">Tus datos</h2>
          </div>
          <div class="detalle-grid detalle-grid--sin-margen">
            <div class="detalle-item"><span class="etiqueta">Nombre</span><span class="valor"><%= t.nombre %></span></div>
            <div class="detalle-item"><span class="etiqueta">RUT</span><span class="valor"><%= rutConPuntos(t.rut) %></span></div>
            <div class="detalle-item"><span class="etiqueta">Fecha de nacimiento</span><span class="valor"><%= fechaDMA(t.fechaNacimiento) %></span></div>
            <div class="detalle-item"><span class="etiqueta">Contacto</span><span class="valor"><%= t.contacto || 'No tienes un contacto registrado' %></span></div>
          </div>
          <p class="ayuda portal-ayuda">¿Algo está mal? <a href="#derechos" data-ir="derechos">Pide corregirlo</a></p>
        </section>

        <section class="panel-card cita-seccion" aria-labelledby="resumen-proxima">
          <div class="cita-seccion-head">
            <span class="cita-seccion-icono" aria-hidden="true"><%- svg('agenda') %></span>
            <h2 id="resumen-proxima">Próxima cita</h2>
          </div>
          <% if (proxima) { %>
            <div class="detalle-grid detalle-grid--sin-margen">
              <div class="detalle-item"><span class="etiqueta">Fecha</span><span class="valor"><%= fechaDMA(proxima.fecha) %></span></div>
              <div class="detalle-item"><span class="etiqueta">Hora</span><span class="valor"><%= proxima.horaInicio %> – <%= proxima.horaFin %></span></div>
              <div class="detalle-item"><span class="etiqueta">Médico</span><span class="valor"><%= proxima.medico %></span></div>
              <div class="detalle-item"><span class="etiqueta">Lugar</span><span class="valor"><%= proxima.pasillo %> · <%= proxima.box %></span></div>
              <div class="detalle-item detalle-item--ancho"><span class="etiqueta">Motivo de consulta</span><span class="valor"><%= proxima.motivoConsulta || '—' %></span></div>
            </div>
          <% } else { %>
            <p class="portal-vacio-texto">No tienes citas agendadas por delante.</p>
          <% } %>
          <a class="btn-mini portal-ver" href="#citas" data-ir="citas">Ver todas mis citas</a>
        </section>
      </div>

      <section class="panel-card portal-franja" aria-label="Consentimientos y solicitudes">
        <div class="portal-franja-item">
          <span class="cita-seccion-icono" aria-hidden="true"><%- svg('escudo') %></span>
          <div class="portal-franja-texto">
            <strong><%= consentimientosVigentes %> de <%= datos.estadoConsentimientos.length %> usos opcionales aceptados</strong>
            <span>Tu atención no depende de ellos: tú decides.</span>
          </div>
          <a class="btn-mini" href="#consentimientos" data-ir="consentimientos">Gestionar</a>
        </div>
        <div class="portal-franja-item">
          <span class="cita-seccion-icono" aria-hidden="true"><%- svg('lapiz') %></span>
          <div class="portal-franja-texto">
            <strong><%= solicitudesPendientes === 0 ? 'Ninguna solicitud pendiente' : solicitudesPendientes + (solicitudesPendientes === 1 ? ' solicitud pendiente' : ' solicitudes pendientes') %></strong>
            <span><%= datos.solicitudes.length === 0 ? 'Aún no has presentado ninguna.' : datos.solicitudes.length + (datos.solicitudes.length === 1 ? ' solicitud en total.' : ' solicitudes en total.') %></span>
          </div>
          <a class="btn-mini" href="#derechos" data-ir="derechos">Ver</a>
        </div>
      </section>
    </section>

    <!-- ===== Mis citas ===== -->
    <section class="portal-seccion" id="citas" data-panel="citas" aria-labelledby="titulo-citas">
      <div class="page-head">
        <div>
          <h1 id="titulo-citas">Mis citas</h1>
          <p class="page-sub">Las atenciones que tienes registradas en el hospital.</p>
        </div>
      </div>

      <% [{ titulo: 'Próximas', lista: proximas, vacio: 'No tienes citas agendadas por delante.' }, { titulo: 'Anteriores', lista: anteriores, vacio: 'No tienes citas anteriores.' }].forEach(function(g) { %>
        <section class="panel-card panel-lista" aria-label="<%= g.titulo %>" data-paginar="10">
          <div class="panel-lista-head">
            <h2><%= g.titulo %> <span class="paciente-citas-total"><%= g.lista.length %></span></h2>
          </div>
          <% if (g.lista.length === 0) { %>
            <p class="panel-lista-vacio"><%= g.vacio %></p>
          <% } else { %>
            <div class="tabla-scroll">
              <table class="tabla">
                <thead><tr><th>Fecha</th><th>Hora</th><th>Médico</th><th>Lugar</th><th>Motivo</th><th>Estado</th></tr></thead>
                <tbody>
                  <% g.lista.forEach(function(c) { %>
                    <% const est = estadoCita(c); %>
                    <tr>
                      <td class="tiempo"><%= fechaDMA(c.fecha) %></td>
                      <td><span class="cita-hora tiempo"><%= c.horaInicio %>–<%= c.horaFin %></span></td>
                      <td>
                        <span class="fila-persona">
                          <span class="avatar" aria-hidden="true"><%= iniciales(c.medico) %></span>
                          <span><strong><%= c.medico %></strong><span class="portal-sub-celda"><%= c.especialidad %></span></span>
                        </span>
                      </td>
                      <td><%= c.pasillo %> · <%= c.box %></td>
                      <td class="portal-celda-motivo"><%= c.motivoConsulta || '—' %></td>
                      <td><span class="badge badge-<%= est[0] %>"><%= est[1] %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <div class="paginacion panel-lista-pie" data-paginacion hidden>
              <span class="paginacion-info" data-pagina-info></span>
              <div class="paginacion-nav">
                <button type="button" class="btn btn-neutro btn--auto btn--control" data-pagina-anterior>← Anterior</button>
                <button type="button" class="btn btn-neutro btn--auto btn--control" data-pagina-siguiente>Siguiente →</button>
              </div>
            </div>
          <% } %>
        </section>
      <% }) %>
    </section>

    <!-- ===== Consentimientos ===== -->
    <section class="portal-seccion" id="consentimientos" data-panel="consentimientos" aria-labelledby="titulo-consentimientos">
      <div class="page-head">
        <div>
          <h1 id="titulo-consentimientos">Usos opcionales de tus datos</h1>
          <p class="page-sub">Tu atención no depende de ninguno. Puedes aceptarlos o revocarlos cuando quieras: revocar tiene efecto inmediato y lo hecho antes sigue siendo válido.</p>
        </div>
      </div>

      <% datos.estadoConsentimientos.forEach(function(c) { %>
        <% const est = CONSENTIMIENTO[c.estado]; %>
        <section class="panel-card panel-lista panel-texto" aria-label="<%= c.finalidad.nombre %>">
          <div class="panel-lista-head">
            <h2><%= c.finalidad.nombre %></h2>
            <span class="badge <%= est[1] %>"><%= est[0] %></span>
          </div>

          <% if (c.otorgadoEl) { %>
            <p class="consentimiento-meta">
              Otorgado el <%= fechaDMA(isoLocal(c.otorgadoEl).slice(0, 16)) %> sobre la versión <%= c.version %> del texto<%= c.otorgadoPor === 'representante' ? ', por tu representante' : '' %><% if (c.revocadoEl) { %>; revocado el <%= fechaDMA(isoLocal(c.revocadoEl).slice(0, 16)) %><% } %>.
            </p>
          <% } %>

          <% if (c.estado === 'vigente') { %>
            <form method="POST" action="/portal/consentimientos/<%= c.finalidad.clave %>/revocar">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-neutro btn--auto btn--control">Revocar este uso</button>
            </form>
          <% } else { %>
            <div class="consentimiento-texto portal-texto-legal">
              <p><%= c.textoVigente.texto %> <span class="ayuda">(versión <%= c.textoVigente.version %>)</span></p>
            </div>
            <form class="consentimiento-form" method="POST" action="/portal/consentimientos/<%= c.finalidad.clave %>/otorgar" data-consentimiento>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="textoId" value="<%= c.textoVigente.id %>" />
              <% if (datos.requiereRepresentante) { %>
                <p class="aviso">El paciente es menor de 14 años: acepta quien tiene su cuidado personal.</p>
                <div class="form-grid form-grid--tres">
                  <div class="field"><label for="rep-nombre-<%= c.finalidad.clave %>">Nombre del representante</label><input id="rep-nombre-<%= c.finalidad.clave %>" name="representanteNombre" maxlength="150" required /></div>
                  <div class="field"><label for="rep-rut-<%= c.finalidad.clave %>">RUT del representante</label><input id="rep-rut-<%= c.finalidad.clave %>" name="representanteRut" maxlength="12" required /></div>
                  <div class="field">
                    <label for="rep-rel-<%= c.finalidad.clave %>">Relación con el paciente</label>
                    <select id="rep-rel-<%= c.finalidad.clave %>" name="representanteRelacion" required>
                      <option value="">Elige…</option>
                      <% relaciones.forEach(function(r) { %><option value="<%= r %>"><%= r %></option><% }) %>
                    </select>
                  </div>
                </div>
              <% } %>
              <div class="consentimiento-fila portal-acepto">
                <label class="casilla"><input type="checkbox" name="acepto" value="si" /> Leí el texto y acepto este uso</label>
                <button type="submit" class="btn btn-primary btn--auto btn--control">Aceptar</button>
              </div>
            </form>
          <% } %>
        </section>
      <% }) %>
    </section>

    <!-- ===== Derechos y solicitudes ===== -->
    <section class="portal-seccion" id="derechos" data-panel="derechos" aria-labelledby="titulo-derechos">
      <div class="page-head">
        <div>
          <h1 id="titulo-derechos">Derechos y solicitudes</h1>
          <p class="page-sub">Pide corregir un dato, eliminarlo o suspender su uso. El hospital responde dentro de 30 días corridos y no tiene costo.</p>
        </div>
      </div>

      <details class="panel-card panel-lista portal-plegable">
        <summary class="panel-lista-head">
          <h2>¿Qué derechos tengo?</h2>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <ul class="portal-derechos">
          <% Object.keys(DERECHOS_TEXTO).forEach(function(d) { %><li><strong><%= e.derecho[d] %>:</strong> <%= DERECHOS_TEXTO[d] %></li><% }) %>
        </ul>
      </details>

      <section class="panel-card panel-lista panel-texto" aria-labelledby="derechos-form">
        <div class="panel-lista-head"><h2 id="derechos-form">Hacer una solicitud</h2></div>
        <form class="consentimiento-form" method="POST" action="/portal/solicitudes" data-solicitud>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-grid">
            <div class="field">
              <label for="derecho">¿Qué necesitas?</label>
              <select id="derecho" name="derecho" required>
                <option value="">Elige una opción…</option>
                <option value="rectificacion">Corregir un dato (rectificación)</option>
                <option value="supresion">Eliminar mis datos (supresión)</option>
                <option value="bloqueo">Suspender el uso de mis datos (bloqueo)</option>
              </select>
            </div>
            <div class="field" data-solo-rectificacion>
              <label for="campo">Dato a corregir</label>
              <select id="campo" name="campo">
                <option value="">Elige el dato…</option>
                <% Object.keys(e.campo).forEach(function(c) { %><option value="<%= c %>"><%= e.campo[c] %></option><% }) %>
              </select>
            </div>
          </div>
          <div class="field" data-solo-rectificacion>
            <label for="valorPropuesto">Valor correcto</label>
            <input id="valorPropuesto" name="valorPropuesto" maxlength="150" autocomplete="off" placeholder="Cómo debería decir" />
          </div>
          <% if (datos.requiereRepresentante) { %>
            <input type="hidden" name="solicitanteEsRepresentante" value="si" />
            <div class="field">
              <label for="solicitanteRelacion">Tu relación con el paciente</label>
              <select id="solicitanteRelacion" name="solicitanteRelacion" required>
                <option value="">Elige la relación…</option>
                <% relaciones.forEach(function(r) { %><option value="<%= r %>"><%= r %></option><% }) %>
              </select>
            </div>
          <% } %>
          <p class="aviso">La supresión y el bloqueo no se pueden deshacer desde aquí: se ejecutan cuando muestras tu cédula en admisión. Los datos clínicos se conservan bloqueados, porque la ley obliga a guardar la ficha clínica.</p>
          <div class="consentimiento-fila">
            <button type="submit" class="btn btn-primary btn--auto btn--control">Enviar solicitud</button>
          </div>
        </form>
      </section>

      <section class="panel-card panel-lista" aria-labelledby="derechos-solicitudes">
        <div class="panel-lista-head">
          <h2 id="derechos-solicitudes">Tus solicitudes <span class="paciente-citas-total"><%= datos.solicitudes.length %></span></h2>
        </div>
        <% if (datos.solicitudes.length === 0) { %>
          <p class="panel-lista-vacio">Todavía no has presentado solicitudes.</p>
        <% } else { %>
          <div class="tabla-scroll">
            <table class="tabla">
              <thead><tr><th>Qué pediste</th><th>Recibida</th><th>Vence</th><th>Estado</th><th>Respuesta del hospital</th></tr></thead>
              <tbody>
                <% datos.solicitudes.slice().reverse().forEach(function(s) { %>
                  <tr>
                    <td><strong><%= e.derecho[s.derecho] %></strong><%= s.campo ? ' · ' + e.campo[s.campo] : '' %></td>
                    <td class="tiempo"><%= fechaDMA(isoLocal(s.recibidaEl).slice(0, 16)) %></td>
                    <td class="tiempo"><%= fechaDMA(isoLocal(s.venceEl).slice(0, 10)) %></td>
                    <td><span class="badge <%= ESTADO_SOLICITUD[s.estado] || 'badge-neutro' %>"><%= e.estadoSolicitud[s.estado] %></span></td>
                    <td><%= s.respuesta || '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </section>

    <!-- ===== Actividad ===== -->
    <section class="portal-seccion" id="actividad" data-panel="actividad" aria-labelledby="titulo-actividad">
      <div class="page-head">
        <div>
          <h1 id="titulo-actividad">Actividad sobre tus datos</h1>
          <p class="page-sub">Qué cambió y quién los consultó. Se muestra la función de quien accedió, no su nombre.</p>
        </div>
      </div>

      <section class="panel-card panel-lista" aria-labelledby="actividad-cambios">
        <div class="panel-lista-head">
          <h2 id="actividad-cambios">Cambios en tus datos <span class="paciente-citas-total"><%= datos.historialCambios.length %></span></h2>
        </div>
        <% if (datos.historialCambios.length === 0) { %>
          <p class="panel-lista-vacio">Tus datos no se han modificado.</p>
        <% } else { %>
          <div class="tabla-scroll">
            <table class="tabla">
              <thead><tr><th>Dato</th><th>Cambiado el</th><th>Valor anterior</th></tr></thead>
              <tbody>
                <% datos.historialCambios.slice().reverse().forEach(function(h) { %>
                  <tr><td><strong><%= e.campo[h.campo] %></strong></td><td class="tiempo"><%= fechaDMA(isoLocal(h.cambiadoEl).slice(0, 16)) %></td><td><%= h.valorAnterior === null ? '(eliminado)' : h.valorAnterior %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <section class="panel-card panel-lista" aria-labelledby="actividad-accesos">
        <div class="panel-lista-head">
          <h2 id="actividad-accesos">Quién accedió a tus datos <span class="paciente-citas-total"><%= datos.accesos.length %></span></h2>
        </div>
        <% if (datos.accesos.length === 0) { %>
          <p class="panel-lista-vacio">Todavía no hay accesos registrados.</p>
        <% } else { %>
          <div class="tabla-scroll tabla-scroll--alta">
            <table class="tabla">
              <thead><tr><th>Fecha</th><th>Quién</th><th>Qué</th><th>Resultado</th></tr></thead>
              <tbody>
                <% datos.accesos.slice().reverse().forEach(function(a) { %>
                  <tr>
                    <td class="tiempo"><%= fechaDMA(isoLocal(a.fecha).slice(0, 16)) %></td>
                    <td><%= a.rol %></td>
                    <td><%= e.accion[a.accion] || a.accion %></td>
                    <td><span class="badge <%= a.resultado === 'exito' ? 'badge-atendido' : 'badge-anulada' %>"><%= e.resultado[a.resultado] || a.resultado %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
        <p class="panel-lista-pie ayuda">Si ves un acceso que no reconoces, avisa al hospital.</p>
      </section>
    </section>

    <!-- ===== Descargas ===== -->
    <section class="portal-seccion" id="descargas" data-panel="descargas" aria-labelledby="titulo-descargas">
      <div class="page-head">
        <div>
          <h1 id="titulo-descargas">Descargar mis datos</h1>
          <p class="page-sub">Tus datos, citas, consentimientos, solicitudes, cambios y quién accedió a ellos, todo en un solo archivo.</p>
        </div>
      </div>

      <form method="POST" action="/portal/descargar" class="portal-dos">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <section class="panel-card cita-seccion" aria-labelledby="descarga-excel">
          <div class="cita-seccion-head">
            <span class="cita-seccion-icono" aria-hidden="true"><%- svg('excel') %></span>
            <h2 id="descarga-excel">Excel</h2>
          </div>
          <p class="portal-descarga-texto">Para llevar tus datos a otro establecimiento. Es el formato estructurado de la portabilidad.</p>
          <button type="submit" name="formato" value="excel" class="btn btn-primary btn--auto btn--control">Descargar en Excel</button>
        </section>
        <section class="panel-card cita-seccion" aria-labelledby="descarga-pdf">
          <div class="cita-seccion-head">
            <span class="cita-seccion-icono" aria-hidden="true"><%- svg('pdf') %></span>
            <h2 id="descarga-pdf">PDF</h2>
          </div>
          <p class="portal-descarga-texto">Para leerlos con calma o imprimirlos. Es la copia de acceso a tus datos.</p>
          <button type="submit" name="formato" value="pdf" class="btn btn-primary btn--auto btn--control">Descargar en PDF</button>
        </section>
      </form>
    </section>

    <!-- ===== Uso de mis datos ===== -->
    <section class="portal-seccion" id="uso" data-panel="uso" aria-labelledby="titulo-uso">
      <div class="page-head">
        <div>
          <h1 id="titulo-uso">Cómo se usan mis datos</h1>
          <p class="page-sub">Para qué usamos cada dato, con qué base legal y hasta cuándo lo conservamos.</p>
        </div>
      </div>

      <section class="panel-card panel-lista" aria-label="Uso de los datos">
        <div class="tabla-scroll">
          <table class="tabla">
            <thead><tr><th>Datos</th><th>Para qué</th><th>Base legal</th><th>Hasta cuándo</th></tr></thead>
            <tbody>
              <% tratamiento.datos.forEach(function(d) { %>
                <tr>
                  <td><strong><%= d.categoria %></strong><span class="portal-sub-celda"><%= d.datos %></span></td>
                  <td><%= d.finalidad %></td>
                  <td><%= d.base %></td>
                  <td><%= d.plazo %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <div class="portal-dos">
        <section class="panel-card cita-seccion" aria-labelledby="uso-compartimos">
          <div class="cita-seccion-head">
            <span class="cita-seccion-icono" aria-hidden="true"><%- svg('usuarios') %></span>
            <h2 id="uso-compartimos">Con quién los compartimos</h2>
          </div>
          <p class="portal-descarga-texto"><%= tratamiento.destinatarios %></p>
        </section>
        <section class="panel-card cita-seccion" aria-labelledby="uso-responsable">
          <div class="cita-seccion-head">
            <span class="cita-seccion-icono" aria-hidden="true"><%- svg('sello') %></span>
            <h2 id="uso-responsable">Responsable</h2>
          </div>
          <p class="portal-descarga-texto"><%= tratamiento.responsable %></p>
        </section>
      </div>

      <p class="portal-enlace-final"><a href="/privacidad">Leer la política de privacidad completa</a></p>
    </section>
  </main>

  <%- include('../partials/toast') %>
  <script src="/js/portal-mis-datos.js"></script>
</body>
</html>
