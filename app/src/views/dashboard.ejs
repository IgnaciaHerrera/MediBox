<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo }) %>
<%
  const ICONOS = {
    agenda: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>',
    paciente: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.2"/><path d="M5 20c1.2-4 4-6 7-6s5.8 2 7 6"/></svg>',
    box: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1.5"/><circle cx="14.5" cy="12" r=".6" fill="currentColor" stroke="none"/></svg>',
    usuario: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="2.8"/><circle cx="17.5" cy="9.5" r="2.1"/><path d="M3.5 19c1-3.2 3-5 5.5-5s4.5 1.8 5.5 5"/><path d="M14.8 14.4c2 .3 3.4 1.9 4.2 4.2"/></svg>',
    notificacion: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 0 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 13 6 9Z"/><path d="M9.5 17a2.5 2.5 0 0 0 5 0"/></svg>',
    datos: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/><path d="M12 3v11m0 0-3.5-3.5M12 14l3.5-3.5"/></svg>',
    escudo: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>',
    flecha: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>',
  };
%>
</head>
<body>
  <%- include('partials/topbar', { usuario, csrfToken, activo: 'dashboard' }) %>

  <main class="dashboard-main">
    <div class="dash-hero">
      <p class="dash-eyebrow"><%= saludo %> · <%= fechaLarga %></p>
      <h1>Hola, <%= usuario.nombre.split(' ')[0] %></h1>
      <p class="dash-sub">Esto es lo que está pasando en MediBox ahora mismo.</p>
    </div>

    <% if (stats.length > 0) { %>
      <div class="dash-stats">
        <% stats.forEach(function(s, i) { %>
          <div class="stat-card" style="animation-delay: <%= i * 60 %>ms;">
            <span class="icono" aria-hidden="true"><%- ICONOS[s.icono] %></span>
            <span class="valor" data-count-to="<%= s.valor %>"><%= s.valor %></span>
            <span class="etiqueta"><%= s.etiqueta %></span>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (atajos.length > 0) { %>
      <h2 class="dash-seccion-titulo">Accesos rápidos</h2>
      <div class="dash-quickactions">
        <% atajos.forEach(function(a) { %>
          <a class="quick-action" href="<%= a.href %>">
            <span class="quick-action-icono" aria-hidden="true"><%- ICONOS[a.icono] %></span>
            <span class="quick-action-texto"><%= a.etiqueta %></span>
            <span class="quick-action-flecha" aria-hidden="true"><%- ICONOS.flecha %></span>
          </a>
        <% }) %>
      </div>
    <% } %>

    <div class="dash-columns">
      <div class="panel-card">
        <div class="panel-card-head">
          <span class="panel-card-icono" aria-hidden="true"><%- ICONOS.agenda %></span>
          <h2><%= agendaHoy.titulo %></h2>
        </div>
        <% if (agendaHoy.items.length === 0) { %>
          <div class="dash-vacio">
            <span class="dash-vacio-icono" aria-hidden="true"><%- ICONOS.agenda %></span>
            <p class="access-empty"><%= agendaHoy.total > 0 ? 'Ya no quedan citas pendientes por hoy.' : 'No hay citas agendadas para hoy.' %></p>
          </div>
        <% } else { %>
          <% agendaHoy.items.forEach(function(c) { %>
            <a class="agenda-preview-item" href="/agenda/<%= c.id %>">
              <span>
                <span class="tiempo"><%= c.horaInicio %>–<%= c.horaFin %></span>
                <span class="agenda-preview-titulo">
                  <%= c.medico.nombre %> · <%= c.box.pasillo.nombre %> — <%= c.box.nombre %>
                </span>
              </span>
              <span class="badge badge-<%= c.estado %>"><%= c.estado.replace('_', ' ') %></span>
            </a>
          <% }) %>
        <% } %>
        <a class="btn-link btn-link-block" href="<%= agendaHoy.href %>"><%= agendaHoy.total > agendaHoy.items.length ? 'Ver las ' + agendaHoy.total + ' citas de hoy' : 'Ver agenda completa' %> →</a>
      </div>

      <div class="panel-card">
        <div class="panel-card-head">
          <span class="panel-card-icono" aria-hidden="true"><%- ICONOS.escudo %></span>
          <h2>Tu rol puede</h2>
        </div>
        <% if (accesos.length === 0) { %>
          <p class="access-empty">Tu cuenta todavía no tiene permisos asignados.</p>
        <% } else { %>
          <div class="accesos-chips">
            <% accesos.forEach(function(grupo) { %>
              <span class="chip"><strong><%= grupo.etiqueta %>:</strong> <%= grupo.acciones.join(', ') %></span>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </main>
  <script src="/js/dashboard.js"></script>
</body>
</html>
