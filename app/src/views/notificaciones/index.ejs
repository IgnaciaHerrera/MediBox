<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head', { titulo }) %>
<%
  const ICONOS = {
    nueva: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4M12 13v6M9 16h6"/></svg>',
    anulada: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4M9.5 13.5l5 5M14.5 13.5l-5 5"/></svg>',
    general: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 0 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 13 6 9Z"/><path d="M9.5 17a2.5 2.5 0 0 0 5 0"/></svg>',
  };

  function tipoNotificacion(mensaje) {
    if (/anuló/i.test(mensaje)) return 'anulada';
    if (/agendada/i.test(mensaje)) return 'nueva';
    return 'general';
  }

  function etiquetaFecha(fecha) {
    const inicioDia = (d) => { const c = new Date(d); c.setHours(0, 0, 0, 0); return c.getTime(); };
    const hoy = inicioDia(new Date());
    const ayer = hoy - 24 * 60 * 60 * 1000;
    const dia = inicioDia(fecha);
    if (dia === hoy) return 'Hoy';
    if (dia === ayer) return 'Ayer';
    const texto = new Date(fecha).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
    return texto.charAt(0).toUpperCase() + texto.slice(1);
  }

  const hayNoLeidas = notificaciones.some((n) => !n.leida);
  let grupoActual = null;
%>
</head>
<body>
  <%- include('../partials/topbar', { usuario, csrfToken, activo: 'notificaciones' }) %>

  <main class="page-main">
    <div class="page-head">
      <h1>Notificaciones</h1>
      <% if (hayNoLeidas) { %>
        <form method="POST" action="/notificaciones/marcar-todas" id="form-marcar-todas">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-secondary btn--auto">Marcar todas como leídas</button>
        </form>
      <% } %>
    </div>

    <% if (notificaciones.length === 0) { %>
      <div class="empty-state">
        <p>No tienes notificaciones.</p>
      </div>
    <% } else { %>
      <div id="lista-notificaciones" data-csrf="<%= csrfToken %>">
        <% notificaciones.forEach(function(n, indice) { %>
          <% const etiqueta = etiquetaFecha(n.createdAt); %>
          <% if (etiqueta !== grupoActual) { grupoActual = etiqueta; %>
            <h2 class="access-heading <%= indice === 0 ? 'sin-margen-superior' : '' %>"><%= etiqueta %></h2>
          <% } %>
          <% const tipo = tipoNotificacion(n.mensaje); %>
          <div class="notif-item <%= n.leida ? 'notif-item--leida' : '' %>" data-id="<%= n.id %>">
            <span class="notif-icono notif-icono--<%= tipo %>" aria-hidden="true"><%- ICONOS[tipo] %></span>
            <div class="notif-cuerpo">
              <p class="notif-mensaje"><% if (!n.leida) { %><span class="sr-only">Sin leer: </span><% } %><%= n.mensaje %></p>
              <span class="notif-hora tiempo"><%= new Date(n.createdAt).toISOString().slice(11, 16) %></span>
            </div>
            <% if (!n.leida) { %>
              <form method="POST" action="/notificaciones/<%= n.id %>/leida" class="form-marcar-leida">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="btn-link">Marcar leída</button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
  <script src="/js/notificaciones.js"></script>
</body>
</html>
