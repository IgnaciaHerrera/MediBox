<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head', { titulo }) %>
<%
  const ICONOS = {
    nueva: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4M12 13v6M9 16h6"/></svg>',
    anulada: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4M9.5 13.5l5 5M14.5 13.5l-5 5"/></svg>',
    general: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 0 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 13 6 9Z"/><path d="M9.5 17a2.5 2.5 0 0 0 5 0"/></svg>',
  };

  function tipoNotificacion(mensaje) {
    if (/anuló/i.test(mensaje)) return 'anulada';
    if (/agendada/i.test(mensaje)) return 'nueva';
    return 'general';
  }

  function etiquetaFecha(fecha) {
    const inicioDia = (d) => { const c = new Date(d); c.setHours(0, 0, 0, 0); return c.getTime(); };
    const hoy = inicioDia(new Date());
    const ayer = hoy - 24 * 60 * 60 * 1000;
    const dia = inicioDia(fecha);
    if (dia === hoy) return 'Hoy';
    if (dia === ayer) return 'Ayer';
    const texto = new Date(fecha).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
    return texto.charAt(0).toUpperCase() + texto.slice(1);
  }

  // Las fechas dentro del mensaje ("2026-10-03") se muestran como día-mes-año;
  // el texto guardado no cambia.
  function mensajeLegible(mensaje) {
    return mensaje.replace(/\b\d{4}-\d{2}-\d{2}\b/g, (iso) => fechaDMA(iso));
  }

  const totalNoLeidas = notificaciones.filter((n) => !n.leida).length;
  const hayNoLeidas = totalNoLeidas > 0;

  // Agrupadas por día, en el orden en que llegan (más recientes primero).
  const grupos = [];
  notificaciones.forEach((n) => {
    const etiqueta = etiquetaFecha(n.createdAt);
    const ultimo = grupos[grupos.length - 1];
    if (ultimo && ultimo.etiqueta === etiqueta) ultimo.items.push(n);
    else grupos.push({ etiqueta, items: [n] });
  });
%>
</head>
<body>
  <%- include('../partials/topbar', { usuario, csrfToken, activo: 'notificaciones' }) %>

  <main class="page-main">
    <div class="page-head">
      <div>
        <h1>Notificaciones</h1>
        <p class="page-sub">Avisos sobre las citas que se agendan o se anulan.</p>
      </div>
      <% if (hayNoLeidas) { %>
        <form method="POST" action="/notificaciones/marcar-todas" id="form-marcar-todas">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-neutro btn--auto btn--control btn--icono">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 12.5 4.5 4.5L15 8.5"/><path d="m11 16 1 1 8.5-8.5"/></svg>
            Marcar todas como leídas
          </button>
        </form>
      <% } %>
    </div>

    <section class="notif-seccion" aria-labelledby="notif-titulo">
      <div class="panel-card notif-barra">
        <h2 id="notif-titulo">Bandeja</h2>
        <% if (notificaciones.length > 0) { %>
          <div class="notif-filtros" role="group" aria-label="Filtrar notificaciones">
            <button type="button" class="notif-filtro" data-filtro-notif="todas" aria-pressed="true">
              Todas <span class="notif-filtro-conteo"><%= notificaciones.length %></span>
            </button>
            <button type="button" class="notif-filtro" data-filtro-notif="no-leidas" aria-pressed="false">
              No leídas <span class="notif-filtro-conteo" data-conteo-no-leidas><%= totalNoLeidas %></span>
            </button>
          </div>
        <% } %>
      </div>

      <% if (notificaciones.length === 0) { %>
        <div class="panel-card notif-vacio">
          <span class="notif-vacio-icono" aria-hidden="true"><%- ICONOS.general %></span>
          <p>No tienes notificaciones.</p>
        </div>
      <% } else { %>
        <div id="lista-notificaciones" data-csrf="<%= csrfToken %>">
          <% grupos.forEach(function(grupo) { %>
            <div class="notif-grupo">
              <h3 class="notif-dia"><%= grupo.etiqueta %></h3>
              <% grupo.items.forEach(function(n) { %>
                <% const tipo = tipoNotificacion(n.mensaje); %>
                <div class="notif-item <%= n.leida ? 'notif-item--leida' : '' %>" data-id="<%= n.id %>">
                  <span class="notif-icono notif-icono--<%= tipo %>" aria-hidden="true"><%- ICONOS[tipo] %></span>
                  <div class="notif-cuerpo">
                    <p class="notif-mensaje"><% if (!n.leida) { %><span class="sr-only">Sin leer: </span><% } %><%= mensajeLegible(n.mensaje) %></p>
                    <span class="notif-hora tiempo"><%= isoLocal(n.createdAt).slice(11, 16) %></span>
                  </div>
                  <% if (!n.leida) { %>
                    <form method="POST" action="/notificaciones/<%= n.id %>/leida" class="form-marcar-leida">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn-mini notif-marcar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
                        Marcar leída
                      </button>
                    </form>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% }) %>
        </div>
        <div class="panel-card notif-vacio" data-notif-sin-pendientes hidden>
          <span class="notif-vacio-icono notif-vacio-icono--ok" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
          </span>
          <p>Estás al día: no tienes notificaciones sin leer.</p>
        </div>
      <% } %>
    </section>
  </main>
  <script src="/js/notificaciones.js"></script>
  <script src="/js/notificaciones-filtro.js"></script>
</body>
</html>
