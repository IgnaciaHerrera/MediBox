<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head', { titulo }) %>
<%
  const ICONOS_EXPORT = {
    Paciente: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.2"/><path d="M5 20c1.2-4 4-6 7-6s5.8 2 7 6"/></svg>',
    Cita: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>',
    AuditLog: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>',
  };
  const ICONO_DESCARGA = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/><path d="M12 3v11m0 0-3.5-3.5M12 14l3.5-3.5"/></svg>';
  const ICONO_SUBIDA = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/><path d="M12 14V3m0 0L8.5 6.5M12 3l3.5 3.5"/></svg>';

  const puedeExportar = tarjetasExport.length > 0;
  const puedeImportar = usuario.permisos.includes('data.import') && usuario.permisos.includes('box.write');
  // Tras un intento de importación (resultado o error) se abre esa pestaña.
  const pestanaInicial = puedeImportar && (resultado || error) ? 'importar' : (puedeExportar ? 'exportar' : 'importar');
  const conPestanas = puedeExportar && puedeImportar;
%>
</head>
<body>
  <%- include('../partials/topbar', { usuario, csrfToken, activo: 'datos' }) %>

  <main class="page-main">
    <div class="page-head">
      <div>
        <h1>Importar y exportar datos</h1>
        <p class="page-sub">Descarga la información del sistema en CSV o carga espacios desde un archivo.</p>
      </div>
    </div>

    <% if (conPestanas) { %>
      <div class="datos-pestanas" role="tablist" aria-label="Importar o exportar">
        <button type="button" class="datos-pestana" role="tab" id="pestana-exportar" aria-controls="panel-exportar" aria-selected="<%= pestanaInicial === 'exportar' %>" data-pestana="exportar"><%- ICONO_DESCARGA %>Exportar</button>
        <button type="button" class="datos-pestana" role="tab" id="pestana-importar" aria-controls="panel-importar" aria-selected="<%= pestanaInicial === 'importar' %>" data-pestana="importar"><%- ICONO_SUBIDA %>Importar espacios</button>
      </div>
    <% } %>

    <% if (puedeExportar) { %>
      <section class="datos-panel" id="panel-exportar" <% if (conPestanas) { %>role="tabpanel" aria-labelledby="pestana-exportar" data-panel="exportar"<% } %>>
        <p class="datos-aviso">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
          Cada descarga queda registrada en la <a href="/auditoria">auditoría</a> a nombre de tu usuario.
        </p>
        <div class="exportar-grid">
          <% tarjetasExport.forEach(function(t) { %>
            <div class="exportar-card">
              <div class="exportar-card-encabezado">
                <span class="exportar-card-icono" aria-hidden="true"><%- ICONOS_EXPORT[t.entidad] || ICONOS_EXPORT.AuditLog %></span>
                <span class="exportar-card-titulo"><%= t.etiqueta %></span>
              </div>
              <p class="exportar-card-meta">
                <% if (t.ultimo) { %>
                  Última exportación: <strong><%= t.ultimo.usuario ? t.ultimo.usuario.nombre : 'usuario eliminado' %></strong>
                  · <span class="tiempo"><%= fechaDMA(isoLocal(t.ultimo.timestamp).slice(0, 16)) %></span>
                <% } else { %>
                  Todavía no se ha exportado.
                <% } %>
              </p>
              <% if (t.entidad === 'Cita' || t.entidad === 'AuditLog') { %>
                <form method="GET" action="<%= t.url %>" class="exportar-form">
                  <details class="exportar-filtros">
                    <summary>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16l-6 7v6l-4 2v-8L4 5Z"/></svg>
                      Filtrar
                    </summary>
                    <div class="exportar-filtros-campos">
                      <div class="field">
                        <label for="filtro-<%= t.entidad %>-desde">Desde</label>
                        <input type="date" id="filtro-<%= t.entidad %>-desde" name="desde" />
                      </div>
                      <div class="field">
                        <label for="filtro-<%= t.entidad %>-hasta">Hasta</label>
                        <input type="date" id="filtro-<%= t.entidad %>-hasta" name="hasta" />
                      </div>
                      <% if (t.entidad === 'Cita') { %>
                        <div class="field exportar-filtros-ancho">
                          <label for="filtro-Cita-estado">Estado</label>
                          <select id="filtro-Cita-estado" name="estado">
                            <option value="">Todos</option>
                            <option value="agendada">Agendada</option>
                            <option value="atendido">Atendido</option>
                            <option value="no_atendido">No atendido</option>
                            <option value="anulada">Anulada</option>
                          </select>
                        </div>
                      <% } else { %>
                        <div class="field exportar-filtros-ancho">
                          <label for="filtro-AuditLog-accion">Acción</label>
                          <select id="filtro-AuditLog-accion" name="accion">
                            <option value="">Todas</option>
                            <% accionesAuditoria.forEach(function(a) { %>
                              <option value="<%= a %>"><%= a %></option>
                            <% }) %>
                          </select>
                        </div>
                      <% } %>
                    </div>
                  </details>
                  <button type="submit" class="btn btn-neutro btn--auto btn--control btn--icono exportar-card-boton"><%- ICONO_DESCARGA %>Descargar CSV</button>
                </form>
              <% } else { %>
                <a class="btn btn-neutro btn--auto btn--control btn--icono exportar-card-boton" href="<%= t.url %>"><%- ICONO_DESCARGA %>Descargar CSV</a>
              <% } %>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (puedeImportar) { %>
      <section class="datos-panel" id="panel-importar" <% if (conPestanas) { %>role="tabpanel" aria-labelledby="pestana-importar" data-panel="importar"<% } %>>
        <% if (error) { %>
          <p class="field-error" role="alert"><%= error %></p>
        <% } %>

        <% if (resultado) { %>
          <p class="aviso-exito" role="status">
            Importación completada: <%= resultado.totalFilas %> fila<%= resultado.totalFilas === 1 ? '' : 's' %> procesada<%= resultado.totalFilas === 1 ? '' : 's' %>,
            <%= resultado.pasillosCreados %> pasillo<%= resultado.pasillosCreados === 1 ? '' : 's' %> nuevo<%= resultado.pasillosCreados === 1 ? '' : 's' %> y
            <%= resultado.boxesCreados %> box<%= resultado.boxesCreados === 1 ? '' : 'es' %> nuevo<%= resultado.boxesCreados === 1 ? '' : 's' %>.
          </p>
        <% } %>

        <div class="importar-grid">
          <form method="POST" action="/datos/importar/espacios" class="form-card" id="form-importar-espacios">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

            <div class="dropzone" id="dropzone-csv" tabindex="0" role="button" aria-label="Subir archivo CSV">
              <span class="dropzone-icono" aria-hidden="true"><%- ICONO_SUBIDA %></span>
              <p class="dropzone-texto">Arrastra un archivo CSV aquí, o <span class="dropzone-enlace">haz clic para elegir uno</span></p>
              <input type="file" id="archivo-csv" accept=".csv,text/csv" hidden />
            </div>

            <div class="field">
              <label for="csv">O pega el contenido directamente</label>
              <textarea id="csv" name="csv" rows="4" required placeholder="pasillo,box&#10;Pasillo A,Box 1&#10;Pasillo A,Box 2"></textarea>
            </div>

            <div id="csv-vista-previa" class="vista-previa" hidden>
              <div class="vista-previa-resumen">
                <span id="vista-previa-total"></span>
                <span id="vista-previa-errores" class="vista-previa-aviso-error" hidden></span>
              </div>
              <div class="vista-previa-scroll">
                <table class="tabla">
                  <thead><tr><th>Pasillo</th><th>Box</th></tr></thead>
                  <tbody id="vista-previa-cuerpo"></tbody>
                </table>
              </div>
            </div>

            <div class="form-acciones">
              <button type="submit" class="btn btn-primary btn--auto">Confirmar importación</button>
            </div>
          </form>

          <aside class="panel-card importar-ayuda" aria-labelledby="importar-ayuda-titulo">
            <h2 id="importar-ayuda-titulo">Formato del archivo</h2>
            <p>Una fila por línea con el formato <code>pasillo,box</code>. La primera fila puede ser el encabezado.</p>
            <pre class="importar-ejemplo">pasillo,box
Pasillo A,Box 1
Pasillo A,Box 2
Pasillo B,Box 3</pre>
            <ul class="importar-reglas">
              <li>Los pasillos que no existan se crean automáticamente.</li>
              <li>Los pasillos y boxes que ya existan se omiten; no se crean duplicados.</li>
              <li>Antes de confirmar verás una vista previa de las filas.</li>
            </ul>
          </aside>
        </div>
      </section>
    <% } %>
  </main>
  <script src="/js/datos.js"></script>
  <script src="/js/datos-importar.js"></script>
</body>
</html>
