<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head', { titulo }) %>
<%
  const HORA_INICIO_GRID = 8;
  const HORA_FIN_GRID = 20;
  const PASO_MIN = 30;
  const TOTAL_FILAS = ((HORA_FIN_GRID - HORA_INICIO_GRID) * 60) / PASO_MIN;

  function filaDeHora(hhmm) {
    const [h, m] = hhmm.split(':').map(Number);
    const fila = Math.round(((h - HORA_INICIO_GRID) * 60 + m) / PASO_MIN);
    return Math.max(0, Math.min(TOTAL_FILAS, fila));
  }

  function urlFiltros({ sinBox, sinMedico, sinPasillo, vistaNueva } = {}) {
    const params = [];
    if (fecha) params.push('fecha=' + encodeURIComponent(fecha));
    if (!sinPasillo && pasilloIdSeleccionado) params.push('pasilloId=' + pasilloIdSeleccionado);
    if (!sinBox && boxIdSeleccionado) params.push('boxId=' + boxIdSeleccionado);
    if (!sinMedico && medicoIdSeleccionado) params.push('medicoId=' + medicoIdSeleccionado);
    const vistaFinal = vistaNueva || vista;
    if (vistaFinal === 'calendario') params.push('vista=calendario');
    return '/agenda' + (params.length ? '?' + params.join('&') : '');
  }

  const pasilloSeleccionadoObj = !modoMia && pasilloIdSeleccionado ? pasillos.find((p) => p.id === pasilloIdSeleccionado) : null;
  const boxSeleccionadoObj = !modoMia && boxIdSeleccionado ? boxes.find((b) => b.id === boxIdSeleccionado) : null;
  const medicoSeleccionadoObj = !modoMia && medicoIdSeleccionado ? medicos.find((m) => m.id === medicoIdSeleccionado) : null;
  const columnasTimeline = !modoMia ? (boxSeleccionadoObj ? [boxSeleccionadoObj] : boxes) : [];

  // Filtros aplicados distintos de la vista por defecto (hoy, sin pasillo,
  // box ni médico). En "Mi agenda" el médico es el propio, no un filtro.
  // "Hoy" se calcula igual que en el controlador para que coincidan.
  const hoy = new Date().toISOString().slice(0, 10);
  const filtrosActivos = [
    fecha !== hoy,
    !modoMia && pasilloIdSeleccionado,
    !modoMia && boxIdSeleccionado,
    !modoMia && medicoIdSeleccionado,
  ].filter(Boolean).length;

  // Iniciales del médico para el avatar, sin contar títulos como "Dr." o "Dra.".
  function iniciales(nombre) {
    return nombre
      .split(' ')
      .filter((p) => p && !p.endsWith('.'))
      .slice(0, 2)
      .map((p) => p.charAt(0).toUpperCase())
      .join('');
  }
%>
</head>
<body>
  <%- include('../partials/topbar', { usuario, csrfToken, activo: modoMia ? 'mia' : 'agenda' }) %>

  <main class="page-main">
    <div class="page-head">
      <div>
        <h1><%= modoMia ? 'Mi agenda' : 'Agenda' %></h1>
        <p class="page-sub">
          <%= modoMia ? 'Revisa tus citas médicas del día y su estado.' : 'Consulta y gestiona las citas médicas por día, box y médico.' %>
        </p>
      </div>
      <% if (puedeCrear) { %>
        <a href="/agenda/nueva" class="btn btn-primary btn--auto btn--control btn--icono">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
          Nueva cita
        </a>
      <% } %>
    </div>

    <% if (typeof sinPerfilMedico !== 'undefined' && sinPerfilMedico) { %>
      <div class="empty-state">
        <p>Tu cuenta de médico todavía no está vinculada a un registro del catálogo de médicos.</p>
        <p>Pide a un administrador que la vincule para ver tu agenda personal.</p>
      </div>
    <% } else { %>
      <form class="filtros" method="GET" action="<%= modoMia ? '/agenda/mia' : '/agenda' %>">
        <% if (!modoMia && vista === 'calendario') { %>
          <input type="hidden" name="vista" value="calendario" />
        <% } %>
        <div class="field">
          <label for="fecha">Fecha</label>
          <input type="date" id="fecha" name="fecha" value="<%= fecha %>" />
        </div>
        <% if (!modoMia) { %>
          <div class="field">
            <label for="pasilloId">Pasillo</label>
            <select id="pasilloId" name="pasilloId">
              <option value="">Todos</option>
              <% pasillos.forEach(function(pasillo) { %>
                <option value="<%= pasillo.id %>" <%= pasilloIdSeleccionado === pasillo.id ? 'selected' : '' %>><%= pasillo.nombre %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label for="boxId">Box</label>
            <select id="boxId" name="boxId">
              <option value="">Todos</option>
              <% boxes.forEach(function(box) { %>
                <option value="<%= box.id %>" <%= boxIdSeleccionado === box.id ? 'selected' : '' %>><%= box.pasillo.nombre %> — <%= box.nombre %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label for="medicoId">Médico</label>
            <select id="medicoId" name="medicoId">
              <option value="">Todos</option>
              <% medicos.forEach(function(medico) { %>
                <option value="<%= medico.id %>" <%= medicoIdSeleccionado === medico.id ? 'selected' : '' %>><%= medico.nombre %></option>
              <% }) %>
            </select>
          </div>
        <% } %>
        <% if (filtrosActivos > 0) { %>
          <a
            class="btn btn--control btn-limpiar"
            href="<%= modoMia ? '/agenda/mia' : '/agenda' + (vista === 'calendario' ? '?vista=calendario' : '') %>"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            Limpiar filtros
            <span class="btn-limpiar-contador" aria-label="<%= filtrosActivos %> <%= filtrosActivos === 1 ? 'filtro activo' : 'filtros activos' %>"><%= filtrosActivos %></span>
          </a>
        <% } %>
      </form>

      <div class="panel-card panel-lista agenda-panel">
        <div class="panel-lista-head">
          <div class="agenda-panel-titulo">
            <h2><%= vista === 'calendario' && !modoMia ? 'Calendario del día' : 'Citas del día' %></h2>
            <span class="agenda-contador"><%= citas.length %></span>
          </div>
        <% if (!modoMia) { %>
          <div class="chip-filtros">
            <% if (pasilloSeleccionadoObj) { %>
              <a class="chip-filtro" href="<%= urlFiltros({ sinPasillo: true, sinBox: true }) %>"><%= pasilloSeleccionadoObj.nombre %> <span class="x">×</span></a>
            <% } %>
            <% if (boxSeleccionadoObj) { %>
              <a class="chip-filtro" href="<%= urlFiltros({ sinBox: true }) %>"><%= boxSeleccionadoObj.pasillo.nombre %> — <%= boxSeleccionadoObj.nombre %> <span class="x">×</span></a>
            <% } %>
            <% if (medicoSeleccionadoObj) { %>
              <a class="chip-filtro" href="<%= urlFiltros({ sinMedico: true }) %>"><%= medicoSeleccionadoObj.nombre %> <span class="x">×</span></a>
            <% } %>
          </div>
          <div class="agenda-toolbar-right">
            <div class="buscador-wrap">
              <svg class="buscador-lupa" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              <input type="search" id="agenda-buscador" class="buscador" placeholder="Buscar médico o box…" aria-label="Buscar médico o box" />
              <button type="button" class="buscador-limpiar" data-buscador-limpiar aria-label="Borrar búsqueda" hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
              </button>
            </div>
            <div class="vista-toggle">
              <a href="<%= urlFiltros({ vistaNueva: 'lista' }) %>" class="vista-btn <%= vista === 'lista' ? 'activo' : '' %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r=".8" fill="currentColor"/><circle cx="3.5" cy="12" r=".8" fill="currentColor"/><circle cx="3.5" cy="18" r=".8" fill="currentColor"/></svg>
                Lista
              </a>
              <a href="<%= urlFiltros({ vistaNueva: 'calendario' }) %>" class="vista-btn <%= vista === 'calendario' ? 'activo' : '' %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>
                Calendario
              </a>
            </div>
          </div>
        <% } %>
        </div>

      <% if (vista === 'lista' || modoMia) { %>
        <% if (citas.length === 0) { %>
          <p class="panel-lista-vacio">No hay citas agendadas para este filtro.</p>
        <% } else { %>
          <div class="tabla-scroll">
            <table class="tabla">
              <thead>
                <tr>
                  <th>Hora</th>
                  <th>Box</th>
                  <th>Médico</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                <% citas.forEach(function(cita) { %>
                  <tr id="cita-<%= cita.id %>" data-busqueda="<%= cita.medico.nombre %> <%= cita.box.nombre %> <%= cita.box.pasillo.nombre %>">
                    <td><span class="cita-hora tiempo"><%= cita.horaInicio %>–<%= cita.horaFin %></span></td>
                    <td>
                      <span class="cita-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="1.5"/><circle cx="14.5" cy="12" r=".6" fill="currentColor" stroke="none"/></svg>
                        <%= cita.box.pasillo.nombre %> · <%= cita.box.nombre %>
                      </span>
                    </td>
                    <td>
                      <span class="fila-persona">
                        <span class="avatar" aria-hidden="true"><%= iniciales(cita.medico.nombre) %></span>
                        <a class="fila-link fila-link--fila" href="/agenda/<%= cita.id %>"><%= cita.medico.nombre %></a>
                      </span>
                    </td>
                    <td><span class="badge badge-<%= cita.estado %>"><%= cita.estado.replace('_', ' ') %></span></td>
                  </tr>
                <% }) %>
                <tr data-sin-resultados hidden><td colspan="4" class="access-empty sin-resultados">Sin resultados para esa búsqueda.</td></tr>
              </tbody>
            </table>
          </div>
        <% } %>
      <% } else { %>
        <% if (columnasTimeline.length === 0) { %>
          <p class="panel-lista-vacio">Todavía no hay boxes registrados para mostrar en el calendario.</p>
        <% } else { %>
          <p class="access-empty sin-resultados" data-sin-resultados hidden>Sin resultados para esa búsqueda.</p>
          <div class="timeline-scroll">
            <div class="timeline-grid" style="grid-template-columns: 3.25rem repeat(<%= columnasTimeline.length %>, minmax(9rem, 1fr)); grid-template-rows: auto repeat(<%= TOTAL_FILAS %>, 2.25rem);">
              <div class="timeline-corner"></div>
              <% columnasTimeline.forEach(function(box) { %>
                <div class="timeline-col-header"><%= box.pasillo.nombre %> — <%= box.nombre %></div>
              <% }) %>

              <% for (let f = 0; f < TOTAL_FILAS; f++) { %>
                <% if (f % 2 === 0) { %>
                  <div class="timeline-hora" style="grid-row: <%= f + 2 %> / span 2;"><%= String(HORA_INICIO_GRID + f / 2).padStart(2, '0') %>:00</div>
                <% } %>
                <% columnasTimeline.forEach(function(box, ci) { %>
                  <div class="timeline-celda<%= f % 2 === 0 ? ' timeline-celda--media' : '' %>" style="grid-row: <%= f + 2 %>; grid-column: <%= ci + 2 %>;"></div>
                <% }) %>
              <% } %>

              <% citas.forEach(function(cita) {
                const colIndex = columnasTimeline.findIndex((b) => b.id === cita.box.id);
                if (colIndex === -1) return;
                const filaIni = filaDeHora(cita.horaInicio);
                const filaFin = Math.max(filaIni + 1, filaDeHora(cita.horaFin));
              %>
                <a
                  class="timeline-bloque badge-<%= cita.estado %>"
                  data-busqueda="<%= cita.medico.nombre %> <%= cita.box.nombre %> <%= cita.box.pasillo.nombre %>"
                  href="/agenda/<%= cita.id %>"
                  style="grid-row: <%= filaIni + 2 %> / <%= filaFin + 2 %>; grid-column: <%= colIndex + 2 %>;"
                >
                  <span class="timeline-bloque-hora"><%= cita.horaInicio %>–<%= cita.horaFin %></span>
                  <span class="timeline-bloque-medico"><%= cita.medico.nombre %></span>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>
      <% } %>
      </div>
    <% } %>
  </main>
  <script src="/js/agenda.js"></script>
</body>
</html>
