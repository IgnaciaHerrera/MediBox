<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head', { titulo }) %>
<%
  const DERECHOS = { acceso: 'Acceso', portabilidad: 'Portabilidad', rectificacion: 'Rectificación', supresion: 'Supresión', bloqueo: 'Bloqueo', oposicion: 'Oposición' };
  const CANALES = { presencial: 'En admisión', telefono: 'Por teléfono', correo: 'Por correo', portal: 'En el portal' };
%>
</head>
<body>
  <%- include('../partials/topbar', { usuario, csrfToken, activo: 'solicitudes' }) %>

  <main class="page-main">
    <div class="page-head">
      <div>
        <h1>Solicitudes de derechos</h1>
        <p class="page-sub">Abiertas, de la más próxima a vencer a la más lejana. Plazo: <%= plazoDias %> días corridos desde la recepción, prorrogable una vez hasta por <%= prorrogaDias %> días; un bloqueo, 2 días hábiles (Ley 21.719, art. 11).</p>
      </div>
    </div>

    <section class="panel-card panel-lista">
      <% if (solicitudes.length === 0) { %>
        <p class="panel-lista-vacio">No hay solicitudes abiertas.</p>
      <% } else { %>
        <div class="tabla-scroll">
          <table class="tabla">
            <thead>
              <tr><th>N°</th><th>Vence</th><th>Titular</th><th>Derecho</th><th>Canal</th><th>Estado</th><th><span class="sr-only">Abrir</span></th></tr>
            </thead>
            <tbody>
              <% solicitudes.forEach(function(s) { %>
                <tr>
                  <td><%= s.id %></td>
                  <td class="tiempo<%= s.dentroDePlazo && !s.porVencer ? '' : ' solicitud-pendiente' %>">
                    <%= fechaDMA(isoLocal(s.venceEl).slice(0, 10)) %><%= s.dentroDePlazo ? (s.porVencer ? ' (por vencer)' : '') : ' (vencida)' %><%= s.prorrogadaEl ? ' · prorrogada' : '' %>
                  </td>
                  <td><%= s.paciente %></td>
                  <td><%= DERECHOS[s.derecho] %></td>
                  <td><%= CANALES[s.canal] %></td>
                  <td>
                    <% if (s.pendienteDeVerificacion) { %>
                      <span class="badge badge-agendada">Pendiente de verificación</span>
                    <% } else { %>
                      <span class="badge badge-atendido">En evaluación</span>
                    <% } %>
                  </td>
                  <td><a class="btn btn-neutro btn--auto btn--control" href="/solicitudes/<%= s.id %>">Abrir</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
