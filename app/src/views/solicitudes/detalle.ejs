<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head', { titulo }) %>
<%
  const DERECHOS = { acceso: 'Acceso', portabilidad: 'Portabilidad', rectificacion: 'Rectificación', supresion: 'Supresión', bloqueo: 'Bloqueo', oposicion: 'Oposición' };
  const CANALES = { presencial: 'En admisión', telefono: 'Por teléfono', correo: 'Por correo', portal: 'En el portal' };
  const CAMPOS = { nombre: 'Nombre', rut: 'RUT', fechaNacimiento: 'Fecha de nacimiento', contacto: 'Contacto' };
  const METODOS = { cedula_presencial: 'cédula en persona', codigo_contacto: 'código al contacto registrado', codigo_portal: 'código ingresado por el titular en el portal' };
  const ESTADOS = { recibida: 'Pendiente de verificación', verificada: 'Verificada: en evaluación', resuelta: 'Resuelta', rechazada: 'Rechazada' };
  const RESULTADOS = { atendida: 'atendida', parcial: 'atendida en parte', rechazada: 'rechazada' };
  const DOCUMENTOS = { certificado_nacimiento: 'Certificado de nacimiento', resolucion_judicial: 'Resolución judicial', poder_notarial: 'Poder notarial' };
  const QUE_HACE = {
    acceso: 'Entrega una copia de todos los datos del titular: en persona (JSON, Excel o PDF) o en el portal, con aviso al contacto registrado.',
    portabilidad: 'Entrega una copia de todos los datos del titular en JSON, para llevarlos a otro responsable (o en Excel o PDF, para revisarla): en persona o en el portal.',
    rectificacion: 'Aplica el valor propuesto a la ficha, con historial del cambio.',
    supresion: 'Elimina el contacto, los consentimientos y los datos del representante, y bloquea lo clínico, que la ley obliga a conservar. Anula sus citas futuras. Se cierra como atendida en parte, con el aviso de reclamo ante la Agencia.',
    bloqueo: 'Bloquea al paciente: se conserva, pero no se usa para nada. Anula sus citas futuras.',
    oposicion: 'Revoca el consentimiento del uso al que se opone.',
  };
  const s = solicitud;
  const abierta = s.estado === 'recibida' || s.estado === 'verificada';
  const esArchivo = s.derecho === 'acceso' || s.derecho === 'portabilidad';
%>
</head>
<body>
  <%- include('../partials/topbar', { usuario, csrfToken, activo: 'solicitudes' }) %>

  <main class="page-main">
    <a class="volver" href="/solicitudes">← Volver a solicitudes</a>
    <div class="page-head">
      <div>
        <h1>N° <%= s.id %> · <%= DERECHOS[s.derecho] %>: <%= paciente.nombre %></h1>
        <p class="page-sub">
          Recibida el <%= fechaDMA(isoLocal(s.recibidaEl).slice(0, 10)) %> (<%= CANALES[s.canal].toLowerCase() %>)<% if (s.verificadaEl) { %> · verificada el <%= fechaDMA(isoLocal(s.verificadaEl).slice(0, 10)) %><% } %>
          · vence el <%= fechaDMA(isoLocal(s.venceEl).slice(0, 10)) %><%= s.prorrogadaEl ? ' (prorrogada)' : '' %> · <%= ESTADOS[s.estado] %>
          <% if (s.metodoVerificacion) { %> con <%= METODOS[s.metodoVerificacion] %><% } %>
          <% if (s.resultado) { %> · <%= RESULTADOS[s.resultado] %><% } %>
        </p>
      </div>
    </div>

    <section class="panel-card panel-lista panel-texto">
      <div class="panel-lista-head"><h2>Qué pide</h2></div>
      <p><%= QUE_HACE[s.derecho] %></p>
      <% if (s.solicitanteEsRepresentante) { %>
        <p class="aviso">
          La presenta su <%= s.solicitanteRelacion === 'apoderado' ? 'apoderado' : 'representante (' + s.solicitanteRelacion + ')' %>;
          representación <%= s.solicitanteAcreditacion === 'declarada' ? 'declarada, sin documento' : 'acreditada con ' + DOCUMENTOS[s.solicitanteAcreditacion].toLowerCase() %>.
          <% if (s.faltaAcreditar) { %>Para ejecutarla falta que acredite la representación con un documento.<% } %>
        </p>
      <% } %>
      <% if (s.derecho === 'rectificacion') { %>
        <p><strong><%= CAMPOS[s.campo] %></strong>: el valor propuesto es <strong><%= s.valorPropuesto %></strong>. Revísalo antes de aplicarlo.</p>
      <% } %>
      <% if (s.derecho === 'oposicion') { %><p>Uso al que se opone: <strong><%= s.finalidadClave %></strong>.</p><% } %>
      <% if (paciente.bloqueado) { %><p class="aviso">Paciente bloqueado: <%= paciente.motivoBloqueo %></p><% } %>
      <% if (s.motivoProrroga) { %><p>Motivo de la prórroga: <%= s.motivoProrroga %></p><% } %>
      <% if (s.respuesta) { %><p>Respuesta registrada: <%= s.respuesta %></p><% } %>
      <p class="ayuda">Método aceptado: <%= s.metodosAceptados.map(function(m) { return METODOS[m]; }).join(' o ') %>.</p>
    </section>

    <% if (s.estado === 'recibida') { %>
      <section class="panel-card panel-lista panel-texto">
        <div class="panel-lista-head"><h2>Verificar la identidad</h2></div>
        <%- include('../partials/verificacion', { pacienteId: paciente.id, verificacion, csrfToken }) %>
        <form method="POST" action="/solicitudes/<%= s.id %>/verificar" class="consentimiento-fila">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <% if (s.faltaAcreditar) { %>
            <select name="documento" required aria-label="Documento que acredita la representación">
              <option value="">Documento del representante…</option>
              <% documentos.forEach(function(d) { %><option value="<%= d %>"><%= DOCUMENTOS[d] %></option><% }) %>
            </select>
          <% } %>
          <button type="submit" class="btn btn-primary btn--auto btn--control">Adjuntar la verificación a la solicitud</button>
        </form>
        <p class="ayuda">Si no se puede verificar ahora, la solicitud queda pendiente hasta la próxima visita del titular. No se rechaza por eso.</p>
      </section>
    <% } %>

    <% if (s.estado === 'verificada' && esArchivo) { %>
      <section class="panel-card panel-lista panel-texto">
        <div class="panel-lista-head"><h2>Generar el archivo del titular</h2></div>
        <% if (!reautenticado) { %>
          <form class="consentimiento-fila" method="POST" action="/solicitudes/reautenticar">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label for="reaut">Confirma tu contraseña</label>
            <input id="reaut" type="password" name="password" autocomplete="current-password" required />
            <button type="submit" class="btn btn-neutro btn--auto btn--control">Confirmar</button>
          </form>
        <% } else { %>
          <form class="consentimiento-fila" method="POST" action="/solicitudes/<%= s.id %>/descargar">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <select name="entrega" required aria-label="Cómo se entrega">
              <option value="">¿Cómo se entrega?</option>
              <option value="presencial">En persona: generar y descargar</option>
              <option value="contacto_registrado">En el portal: avisar al contacto registrado</option>
            </select>
            <select name="formato" aria-label="Formato (en persona)">
              <option value="json">JSON (portabilidad)</option>
              <option value="excel">Excel (planilla)</option>
              <option value="pdf">PDF (para leer o imprimir)</option>
            </select>
            <button type="submit" class="btn btn-primary btn--auto btn--control">Entregar</button>
          </form>
        <% } %>
        <p class="ayuda">Nunca por el canal por el que llamaron: en persona, o en el portal del paciente, donde el titular entra con un código que llega a su contacto registrado. A distancia el archivo no pasa por tu correo.</p>
      </section>
    <% } %>

    <% if (s.estado === 'verificada' && !esArchivo) { %>
      <section class="panel-card panel-lista panel-texto">
        <div class="panel-lista-head"><h2>Resolver</h2></div>
        <form class="consentimiento-form" method="POST" action="/solicitudes/<%= s.id %>/ejecutar">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label for="respuesta">Respuesta al titular</label>
          <textarea id="respuesta" name="respuesta" rows="3" maxlength="2000" required></textarea>
          <button type="submit" class="btn btn-primary btn--auto btn--control">Ejecutar y responder</button>
        </form>
      </section>
    <% } %>

    <% if (abierta && !s.prorrogadaEl && s.derecho !== 'bloqueo') { %>
      <section class="panel-card panel-lista panel-texto">
        <div class="panel-lista-head"><h2>Prorrogar el plazo</h2></div>
        <form class="consentimiento-form" method="POST" action="/solicitudes/<%= s.id %>/prorrogar">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label for="prorroga-dias">Días (una sola vez, hasta <%= prorrogaDias %>)</label>
          <input id="prorroga-dias" name="dias" type="number" min="1" max="<%= prorrogaDias %>" value="<%= prorrogaDias %>" required />
          <label for="prorroga-motivo">Motivo, para el titular</label>
          <textarea id="prorroga-motivo" name="motivo" rows="2" maxlength="1000" required></textarea>
          <button type="submit" class="btn btn-neutro btn--auto btn--control">Prorrogar</button>
        </form>
      </section>
    <% } %>

    <% if (s.estado === 'verificada') { %>
      <section class="panel-card panel-lista panel-texto">
        <div class="panel-lista-head"><h2>Rechazar por el fondo</h2></div>
        <form class="consentimiento-form" method="POST" action="/solicitudes/<%= s.id %>/rechazar">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label for="motivo-rechazo">Motivo, para el titular</label>
          <textarea id="motivo-rechazo" name="respuesta" rows="2" maxlength="2000" required></textarea>
          <button type="submit" class="btn btn-neutro btn--auto btn--control">Rechazar</button>
        </form>
      </section>
    <% } %>

    <% if (s.derecho === 'bloqueo' && s.estado === 'resuelta' && paciente.bloqueado && !paciente.suprimido) { %>
      <section class="panel-card panel-lista panel-texto">
        <div class="panel-lista-head"><h2>Levantar el bloqueo</h2></div>
        <form method="POST" action="/solicitudes/<%= s.id %>/desbloquear">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-neutro btn--auto btn--control">La situación se aclaró: desbloquear</button>
        </form>
      </section>
    <% } %>
    <section class="panel-card panel-lista panel-texto">
      <div class="panel-lista-head"><h2>Registrar otra solicitud del titular</h2></div>
      <p class="ayuda">Para cuando el titular presenta una nueva petición. Sirve también si está bloqueado y el operador ya no lo ve en la ficha.</p>
      <form class="consentimiento-form" method="POST" action="/solicitudes/<%= s.id %>/nueva">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="consentimiento-fila">
          <select name="derecho" required aria-label="Derecho">
            <option value="">Derecho…</option>
            <% Object.keys(DERECHOS).forEach(function(d) { %><option value="<%= d %>"><%= DERECHOS[d] %></option><% }) %>
          </select>
          <select name="canal" required aria-label="Canal">
            <option value="">¿Por dónde llegó?</option>
            <% Object.keys(CANALES).forEach(function(c) { %><option value="<%= c %>"><%= CANALES[c] %></option><% }) %>
          </select>
          <select name="campo" aria-label="Dato a corregir (rectificación)">
            <option value="">Dato a corregir…</option>
            <% Object.keys(CAMPOS).forEach(function(c) { %><option value="<%= c %>"><%= CAMPOS[c] %></option><% }) %>
          </select>
          <input name="valorPropuesto" maxlength="150" autocomplete="off" placeholder="Valor correcto (rectificación)" aria-label="Valor correcto" />
          <button type="submit" class="btn btn-neutro btn--auto btn--control">Registrar</button>
        </div>
      </form>
    </section>
  </main>
</body>
</html>
