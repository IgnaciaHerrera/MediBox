<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head', { titulo }) %>
<%
  function iniciales(nombre) {
    const partes = nombre.trim().split(/\s+/);
    const primera = partes[0] ? partes[0][0] : '';
    const ultima = partes.length > 1 ? partes[partes.length - 1][0] : '';
    return (primera + ultima).toUpperCase();
  }
  const medicosDisponibles = medicos.filter((m) => !m.usuarioId);
  function medicoVinculadoDe(usuarioId) {
    return medicos.find((m) => m.usuarioId === usuarioId) || null;
  }
%>
</head>
<body>
  <%- include('../partials/topbar', { usuario, csrfToken, activo: 'usuarios' }) %>

  <main class="page-main">
    <div class="page-head">
      <div>
        <h1>Usuarios</h1>
        <p class="page-sub">Administra quién accede al sistema y con qué rol.</p>
      </div>
      <button type="button" class="btn btn-primary btn--auto btn--control btn--icono" id="btn-crear-usuario">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        Crear usuario
      </button>
    </div>

    <% if (error) { %>
      <p class="field-error" role="alert"><%= error %></p>
    <% } %>

    <section class="panel-card panel-lista" aria-labelledby="usuarios-titulo">
      <div class="panel-lista-head">
        <h2 id="usuarios-titulo">Usuarios del sistema</h2>
        <span class="agenda-contador"><%= usuarios.length %></span>
        <div class="buscador-form">
          <label for="usuarios-buscador" class="sr-only">Buscar</label>
          <div class="buscador-wrap">
            <svg class="buscador-lupa" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="search" id="usuarios-buscador" class="buscador" placeholder="Nombre o correo…" />
            <button type="button" class="buscador-limpiar" data-buscador-limpiar aria-label="Borrar búsqueda" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
          </div>
        </div>
      </div>

      <div class="tabla-scroll">
        <table class="tabla">
          <thead>
            <tr><th>Usuario</th><th>Correo</th><th>Rol</th><th><span class="sr-only">Acciones</span></th></tr>
          </thead>
          <tbody>
            <% usuarios.forEach(function(u) { %>
              <% const medicoVinculado = medicoVinculadoDe(u.id); %>
              <tr data-busqueda="<%= u.nombre %> <%= u.email %>">
                <td>
                  <span class="fila-persona">
                    <span class="avatar"><%= iniciales(u.nombre) %></span>
                    <span class="usuario-identidad">
                      <span class="usuario-nombre">
                        <%= u.nombre %>
                        <% if (u.id === usuario.id) { %><span class="usuario-tu">Tú</span><% } %>
                      </span>
                    </span>
                  </span>
                </td>
                <td>
                  <span class="dato-con-icono">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                    <%= u.email %>
                  </span>
                </td>
                <td><span class="rol-chip rol-chip--<%= u.rol.nombre %>"><%= u.rol.nombre %></span></td>
                <td class="celda-derecha">
                  <a
                    class="fila-link btn-editar-usuario btn-mini"
                    href="/usuarios/<%= u.id %>/editar"
                    data-id="<%= u.id %>"
                    data-nombre="<%= u.nombre %>"
                    data-email="<%= u.email %>"
                    data-rol-id="<%= u.rolId %>"
                    data-es-uno-mismo="<%= u.id === usuario.id ? '1' : '0' %>"
                    <% if (medicoVinculado) { %>
                      data-medico-id="<%= medicoVinculado.id %>"
                      data-medico-nombre="<%= medicoVinculado.nombre %>"
                    <% } %>
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4Z"/><path d="m13.5 6.5 4 4"/></svg>
                    Editar
                  </a>
                </td>
              </tr>
            <% }) %>
            <tr id="fila-sin-resultados" hidden><td colspan="4" class="access-empty sin-resultados">Sin resultados para esa búsqueda.</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <dialog id="modal-crear-usuario" class="modal modal--formulario" aria-labelledby="modal-crear-usuario-titulo">
    <form method="dialog" class="modal-cerrar-form">
      <button type="submit" class="modal-cerrar" aria-label="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </form>
    <div class="modal-cabecera">
      <span class="modal-icono" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="8" r="3.2"/><path d="M3.5 20c1.1-3.7 3.6-5.6 6.5-5.6 1.4 0 2.7.4 3.8 1.3"/><path d="M18 14v6M15 17h6"/></svg>
      </span>
      <div>
        <h3 id="modal-crear-usuario-titulo">Crear usuario</h3>
        <p class="modal-subtitulo">Da acceso a una persona del equipo con su rol.</p>
      </div>
    </div>
    <form method="POST" action="/usuarios">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field">
        <label for="crear-nombre">Nombre completo</label>
        <input type="text" id="crear-nombre" name="nombre" required />
      </div>
      <div class="field">
        <label for="crear-email">Correo institucional</label>
        <input type="email" id="crear-email" name="email" required />
      </div>
      <div class="field">
        <label for="crear-password">Contraseña</label>
        <input type="password" id="crear-password" name="password" minlength="8" required />
      </div>
      <div class="field">
        <label for="crear-rolId">Rol</label>
        <select id="crear-rolId" name="rolId" required data-rol-medico-id="<%= rolMedicoId %>">
          <option value="">Selecciona</option>
          <% roles.forEach(function(r) { %>
            <option value="<%= r.id %>"><%= r.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="field" id="crear-campo-medico" hidden>
        <label for="crear-medicoId">Perfil de médico</label>
        <select id="crear-medicoId" name="medicoId">
          <option value="">Sin vincular</option>
          <% medicosDisponibles.forEach(function(m) { %>
            <option value="<%= m.id %>"><%= m.nombre %> — <%= m.especialidad.nombre %></option>
          <% }) %>
        </select>
        <p class="ayuda">Habilita que esta cuenta vea "Mi agenda" con las citas de ese médico.</p>
      </div>
      <div class="modal-acciones">
        <button type="button" class="btn btn-neutro btn--auto btn--control" data-cerrar-modal>Cancelar</button>
        <button type="submit" class="btn btn-primary btn--auto btn--control">Crear usuario</button>
      </div>
    </form>
  </dialog>

  <dialog id="modal-editar-usuario" class="modal modal--formulario" aria-labelledby="modal-editar-usuario-titulo">
    <form method="dialog" class="modal-cerrar-form">
      <button type="submit" class="modal-cerrar" aria-label="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </form>
    <div class="modal-cabecera">
      <span class="modal-icono" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="8" r="3.2"/><path d="M3.5 20c1.1-3.7 3.6-5.6 6.5-5.6"/><path d="m14.5 19.5 1-3.5 4.5-4.5 2.5 2.5-4.5 4.5-3.5 1Z"/></svg>
      </span>
      <div>
        <h3 id="modal-editar-usuario-titulo">Editar usuario</h3>
        <p class="modal-subtitulo">Actualiza el nombre, el rol o la contraseña.</p>
      </div>
    </div>
    <form method="POST" id="form-editar-usuario">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field">
        <label for="editar-nombre">Nombre completo</label>
        <input type="text" id="editar-nombre" name="nombre" required />
      </div>
      <div class="field">
        <label>Correo</label>
        <input type="email" id="editar-email" disabled />
      </div>
      <div class="field">
        <label for="editar-rolId">Rol</label>
        <select id="editar-rolId" name="rolId" required data-rol-medico-id="<%= rolMedicoId %>">
          <% roles.forEach(function(r) { %>
            <option value="<%= r.id %>"><%= r.nombre %></option>
          <% }) %>
        </select>
        <input type="hidden" id="editar-rolId-oculto" name="rolId" disabled />
        <p id="editar-aviso-rol" class="ayuda-error" hidden>No puedes cambiar tu propio rol.</p>
      </div>
      <div class="field" id="editar-campo-medico" hidden>
        <label for="editar-medicoId">Perfil de médico</label>
        <select id="editar-medicoId" name="medicoId">
          <option value="">Sin vincular</option>
          <% medicosDisponibles.forEach(function(m) { %>
            <option value="<%= m.id %>"><%= m.nombre %> — <%= m.especialidad.nombre %></option>
          <% }) %>
        </select>
        <p class="ayuda">Habilita que esta cuenta vea "Mi agenda" con las citas de ese médico.</p>
      </div>
      <div class="field">
        <label for="editar-nuevaPassword">Nueva contraseña (opcional)</label>
        <input type="password" id="editar-nuevaPassword" name="nuevaPassword" minlength="8" placeholder="Dejar en blanco para no cambiarla" />
      </div>
      <div class="modal-acciones">
        <button type="button" class="btn btn-neutro btn--auto btn--control" data-cerrar-modal>Cancelar</button>
        <button type="submit" class="btn btn-primary btn--auto btn--control">Guardar cambios</button>
      </div>
    </form>
  </dialog>
  <script src="/js/usuarios.js"></script>
</body>
</html>
