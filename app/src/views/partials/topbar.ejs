<%
  // aria-current="page" es lo que le dice a un lector de pantalla cuál link
  // de este menú es la página actual — la clase "activo" solo lo muestra
  // visualmente. Se centraliza acá para no repetir la condición 9 veces.
  function navAttrs(clave) {
    return activo === clave ? 'class="activo" aria-current="page"' : '';
  }

  // Íconos de línea (trazos de Lucide), todos con el mismo grosor.
  const trazos = {
    panel: '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
    agenda: '<path d="M8 2v4"/><path d="M16 2v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/>',
    mia: '<path d="M8 2v4"/><path d="M16 2v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/>',
    pacientes: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
    espacios: '<path d="M18 20V6a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v14"/><path d="M2 20h20"/><path d="M14 12v.01"/>',
    medicos: '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
    auditoria: '<rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/>',
    usuarios: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    roles: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
    datos: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>',
    campana: '<path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/>',
    menu: '<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>',
    cerrar: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
    salir: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>'
  };
  function icono(nombre, extra = '') {
    return `<svg class="topbar-icon" ${extra} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${trazos[nombre]}</svg>`;
  }

  const etiquetasRol = { admin: 'Administrador', medico: 'Médico', gestor: 'Gestor', consulta: 'Consulta', operador: 'Operador' };
  const rolVisible = etiquetasRol[usuario.rolNombre] || usuario.rolNombre;
  // Si el nombre ya dice el rol ("Administrador MediBox") no lo repetimos.
  const mostrarRol = !usuario.nombre.toLowerCase().includes(rolVisible.toLowerCase());

  const verAuditoria = usuario.permisos.includes('auditoria.read');
  const verUsuarios = usuario.permisos.includes('admin.users');
  const verRoles = usuario.permisos.includes('admin.roles');
  const verDatos = usuario.permisos.includes('data.export') || usuario.permisos.includes('data.import');
  const hayAdmin = verAuditoria || verUsuarios || verRoles || verDatos;

  const noLeidas = usuario.notificacionesNoLeidas;
%>
<header class="topbar" data-topbar>
  <div class="topbar-start">
    <button
      type="button"
      class="topbar-menu"
      data-topbar-abrir
      aria-controls="topbar-nav"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <%- icono('menu') %>
    </button>
    <a class="topbar-brand" href="/dashboard">MediBox</a>
  </div>

  <div class="topbar-velo" data-topbar-cerrar hidden></div>

  <nav class="topbar-nav" id="topbar-nav" aria-label="Principal">
    <div class="topbar-nav-head">
      <span class="topbar-brand">MediBox</span>
      <button type="button" class="topbar-menu" data-topbar-cerrar aria-label="Cerrar menú">
        <%- icono('cerrar') %>
      </button>
    </div>
    <a href="/dashboard" <%- navAttrs('dashboard') %>><%- icono('panel') %>Panel</a>
    <a href="/agenda" <%- navAttrs('agenda') %>><%- icono('agenda') %>Agenda</a>
    <% if (usuario.rolNombre === 'medico') { %>
      <a href="/agenda/mia" <%- navAttrs('mia') %>><%- icono('mia') %>Mi agenda</a>
    <% } %>
    <% if (usuario.permisos.includes('paciente.read')) { %>
      <a href="/pacientes" <%- navAttrs('pacientes') %>><%- icono('pacientes') %>Pacientes</a>
    <% } %>
    <a href="/espacios" <%- navAttrs('espacios') %>><%- icono('espacios') %>Espacios</a>
    <a href="/medicos" <%- navAttrs('medicos') %>><%- icono('medicos') %>Médicos</a>
    <% if (hayAdmin) { %>
      <% if (verAuditoria) { %><a href="/auditoria" <%- navAttrs('auditoria') %>><%- icono('auditoria') %>Auditoría</a><% } %>
      <% if (verUsuarios) { %><a href="/usuarios" <%- navAttrs('usuarios') %>><%- icono('usuarios') %>Usuarios</a><% } %>
      <% if (verRoles) { %><a href="/roles" <%- navAttrs('roles') %>><%- icono('roles') %>Roles</a><% } %>
      <% if (verDatos) { %><a href="/datos" <%- navAttrs('datos') %>><%- icono('datos') %>Datos</a><% } %>
    <% } %>

    <div class="topbar-nav-foot">
      <div class="topbar-identity">
        <strong><%= usuario.nombre %></strong>
        <% if (mostrarRol) { %><span><%= rolVisible %></span><% } %>
      </div>
      <form method="POST" action="/auth/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="topbar-logout"><%- icono('salir') %>Salir</button>
      </form>
    </div>
  </nav>

  <div class="topbar-user">
    <a
      class="topbar-bell <%= activo === 'notificaciones' ? 'activo' : '' %>"
      href="/notificaciones"
      <%- activo === 'notificaciones' ? 'aria-current="page"' : '' %>
      aria-label="Notificaciones<%= noLeidas > 0 ? ` (${noLeidas} sin leer)` : '' %>"
    >
      <%- icono('campana') %>
      <% if (noLeidas > 0) { %>
        <span class="topbar-badge" aria-hidden="true"><%= noLeidas > 9 ? '9+' : noLeidas %></span>
      <% } %>
    </a>

    <div class="topbar-identity topbar-desktop">
      <strong><%= usuario.nombre %></strong>
      <% if (mostrarRol) { %><span><%= rolVisible %></span><% } %>
    </div>

    <form method="POST" action="/auth/logout" class="topbar-desktop">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="topbar-logout"><%- icono('salir') %>Salir</button>
    </form>
  </div>
</header>
<script src="/js/topbar.js" defer></script>
