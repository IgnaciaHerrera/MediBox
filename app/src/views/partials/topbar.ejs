<%
  // aria-current="page" es lo que le dice a un lector de pantalla cuál link
  // de este menú es la página actual — la clase "activo" solo lo muestra
  // visualmente. Se centraliza acá para no repetir la condición 9 veces.
  function navAttrs(clave) {
    return activo === clave ? 'class="activo" aria-current="page"' : '';
  }
%>
<header class="topbar">
  <div class="topbar-left">
    <a class="topbar-brand" href="/dashboard">MediBox</a>
    <nav class="topbar-nav">
      <a href="/dashboard" <%- navAttrs('dashboard') %>>Panel</a>
      <a href="/agenda" <%- navAttrs('agenda') %>>Agenda</a>
      <% if (usuario.rolNombre === 'medico') { %>
        <a href="/agenda/mia" <%- navAttrs('mia') %>>Mi agenda</a>
      <% } %>
      <% if (usuario.permisos.includes('paciente.read')) { %>
        <a href="/pacientes" <%- navAttrs('pacientes') %>>Pacientes</a>
      <% } %>
      <a href="/espacios" <%- navAttrs('espacios') %>>Espacios</a>
      <a href="/medicos" <%- navAttrs('medicos') %>>Médicos</a>
      <a href="/notificaciones" <%- navAttrs('notificaciones') %>>
        Notificaciones
        <% if (usuario.notificacionesNoLeidas > 0) { %>
          <span class="topbar-badge"><%= usuario.notificacionesNoLeidas > 9 ? '9+' : usuario.notificacionesNoLeidas %></span>
        <% } %>
      </a>
      <% if (usuario.permisos.includes('auditoria.read')) { %>
        <a href="/auditoria" <%- navAttrs('auditoria') %>>Auditoría</a>
      <% } %>
      <% if (usuario.permisos.includes('admin.users')) { %>
        <a href="/usuarios" <%- navAttrs('usuarios') %>>Usuarios</a>
      <% } %>
      <% if (usuario.permisos.includes('admin.roles')) { %>
        <a href="/roles" <%- navAttrs('roles') %>>Roles</a>
      <% } %>
      <% if (usuario.permisos.includes('data.export') || usuario.permisos.includes('data.import')) { %>
        <a href="/datos" <%- navAttrs('datos') %>>Datos</a>
      <% } %>
    </nav>
  </div>
  <div class="topbar-user">
    <span><strong><%= usuario.nombre %></strong></span>
    <form method="POST" action="/auth/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="btn btn-secondary">Salir</button>
    </form>
  </div>
</header>
