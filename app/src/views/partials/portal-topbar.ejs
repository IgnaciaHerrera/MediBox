<%
  // Misma barra superior que usa el personal (clases .topbar de dashboard.css),
  // con las secciones de Mis datos como menú. En pantallas angostas pasa a ser
  // el menú lateral que abre topbar.js.
  const trazos = {
    resumen: '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
    citas: '<path d="M8 2v4"/><path d="M16 2v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/>',
    consentimientos: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
    derechos: '<path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>',
    actividad: '<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/>',
    descargas: '<path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/>',
    uso: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
    menu: '<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>',
    cerrar: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
    salir: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>'
  };
  function icono(nombre) {
    return `<svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${trazos[nombre]}</svg>`;
  }
%>
<header class="topbar" data-topbar>
  <div class="topbar-start">
    <button
      type="button"
      class="topbar-menu"
      data-topbar-abrir
      aria-controls="topbar-nav"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <%- icono('menu') %>
    </button>
    <a class="topbar-brand portal-marca" href="/portal/mis-datos#resumen"><span class="landing-logo-icono" aria-hidden="true"><img src="/img/logo-medibox-verde.png" alt="" width="240" height="200"></span>MediBox</a>
  </div>

  <div class="topbar-velo" data-topbar-cerrar hidden></div>

  <nav class="topbar-nav" id="topbar-nav" aria-label="Secciones de Mis datos">
    <div class="topbar-nav-head">
      <span class="topbar-brand portal-marca"><span class="landing-logo-icono" aria-hidden="true"><img src="/img/logo-medibox-verde.png" alt="" width="240" height="200"></span>MediBox</span>
      <button type="button" class="topbar-menu" data-topbar-cerrar aria-label="Cerrar menú">
        <%- icono('cerrar') %>
      </button>
    </div>
    <% secciones.forEach(function(s) { %>
      <a href="#<%= s.id %>" data-pestana="<%= s.id %>"><%- icono(s.icono) %><%= s.nombre %><% if (s.cuenta) { %><span class="portal-nav-cuenta"><%= s.cuenta %></span><% } %></a>
    <% }) %>

    <div class="topbar-nav-foot">
      <div class="topbar-identity">
        <strong><%= nombre %></strong>
        <span>Sesión hasta las <%= sesionHasta %></span>
      </div>
      <form method="POST" action="/portal/salir">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="topbar-logout"><%- icono('salir') %>Salir</button>
      </form>
    </div>
  </nav>

  <div class="topbar-user">
    <div class="topbar-identity topbar-desktop">
      <strong><%= nombre %></strong>
      <span>Sesión hasta las <%= sesionHasta %></span>
    </div>

    <form method="POST" action="/portal/salir" class="topbar-desktop">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="topbar-logout"><%- icono('salir') %>Salir</button>
    </form>
  </div>
</header>
<script src="/js/topbar.js" defer></script>
